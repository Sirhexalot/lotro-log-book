{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="companion" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite">
<h2 data-t="cp_titel">Spielstand mit LOTRO Companion auslesen</h2>
	<p data-t-html="cp_einleitung"></p>
	<ul data-t-html="cp_brauchst"></ul>

	<h2 data-t="cp_schritt1">1. Companion starten</h2>
	<div class="reiter" role="tablist">
		<button type="button" data-reiter="windows" aria-pressed="true">Windows</button>
		<button type="button" data-reiter="mac" aria-pressed="false">macOS</button>
	</div>
	<div class="kasten reiter-inhalt" data-inhalt="windows">
		<ol data-t-html="cp_windows"></ol>
	</div>
	<div class="kasten reiter-inhalt" data-inhalt="mac" hidden>
		<ol data-t-html="cp_mac"></ol>
		<code class="befehl" id="mac-befehl">for A in "$HOME/Applications" "/Applications"; do
  S="$A/The Lord of the Rings Online.app/Contents/SharedSupport"; [ -d "$S" ] &amp;&amp; break
done
for C in "$HOME/Applications/LotRO Companion" "/Applications/LotRO Companion" "$HOME/Applications/"*/"LotRO Companion"; do
  [ -d "$C/app" ] &amp;&amp; break
done
cd "$C/app" &amp;&amp; WINEPREFIX="$S/prefix" WINEMSYNC=1 WINEESYNC=1 WINEDEBUG=-all \
  DYLD_FALLBACK_LIBRARY_PATH="$S/wine/lib" "$S/wine/bin/wine64" "../LotRO Companion.exe"</code>
		<div class="zeile-knoepfe"><button type="button" id="mac-kopieren" data-t="cp_kopieren">Befehl kopieren</button></div>
		<p class="schwach" data-t-html="cp_mac_warnung"></p>
	</div>

	<h2 data-t="cp_schritt2">2. Beim ersten Mal: LOTRO finden</h2>
	<p data-t-html="cp_pfad"></p>

	<h2 data-t="cp_schritt3">3. Den Charakter auslesen</h2>
	<figure class="bild">
		<img src="bild/companion-import-knopf.png" width="912" height="115" loading="lazy"
			alt="Companion, Leiste Sonstiges mit dem Knopf Importieren von HdRO">
		<figcaption data-t="cp_bild1"></figcaption>
	</figure>
	<ol data-t-html="cp_auslesen"></ol>
	<p class="schwach" data-t-html="cp_admin"></p>

	<h2 data-t="cp_schritt4">4. Deinen Spielstand finden</h2>
	<p data-t-html="cp_dateien"></p>
	<div class="kasten">
		<div class="reiter-inhalt" data-inhalt="windows"><span data-t-html="cp_pfad_windows"></span></div>
		<div class="reiter-inhalt" data-inhalt="mac" hidden><span data-t-html="cp_pfad_mac"></span></div>
	</div>

	<h2 data-t="cp_schritt5">5. Zurück zur Importseite</h2>
	<p data-t-html="cp_import"></p>
	<p data-t="cp_mehrere"></p>
	<p class="schwach" data-t="cp_wiederholen"></p>
	<div class="zeile-knoepfe">
		<a class="knopf-gold" data-ziel="spielstand.html" href="spielstand.html?lang=de" data-t="cp_weiter">Zur Importseite</a>
	</div>

	<h2 data-t="cp_fragen">Wenn es klemmt</h2>
	<div data-t-html="cp_faq"></div>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js" defer></script>
<script src="/texte-spielstand.js" defer></script>
<script src="/texte-logbuch.js" defer></script>
<script src="/texte-site.js" defer></script>
<script src="/texte-companion.js" defer></script>
<script src="/sprache.js" defer></script>
<script src="/speicher.js" defer></script>
<script src="/menue.js" defer></script>
<script src="/anleitung.js" defer></script>
{% endblock %}
