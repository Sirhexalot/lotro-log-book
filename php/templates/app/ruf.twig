{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="ruf" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite">
<h2 data-t="ru_titel">Ruf</h2>
	<p data-t="ru_text"></p>
	<p class="meldung" id="hinweis"></p>
	<div class="kopf-zeile" id="steuerung">
		<input type="search" id="filter" data-t-ph="ru_suche" autocomplete="off">
		<label><input type="checkbox" id="nur-begonnen"> <span data-t="ru_nur_begonnen">nur begonnene Fraktionen</span></label>
		<span class="stufe-klein" id="anzahl"></span>
	</div>
	<div class="tabellen-rahmen"><table class="tabelle" id="tabelle">
		<thead><tr>
			<th data-t="ru_fraktion">Fraktion</th>
			<th data-t="ru_stufe">Stufe</th>
			<th style="width:30%"></th>
			<th class="zahl" data-t="ru_punkte">Punkte</th>
		</tr></thead>
		<tbody id="zeilen"></tbody>
	</table></div>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js" defer></script>
<script src="/texte-spielstand.js" defer></script>
<script src="/texte-logbuch.js" defer></script>
<script src="/texte-site.js" defer></script>
<script src="/sprache.js" defer></script>
<script src="/speicher.js" defer></script>
<script src="/menue.js" defer></script>
<script src="/referenz.js" defer></script>
<script src="/ruf.js" defer></script>
{% endblock %}
