<!doctype html>
{# Shared shell of the application pages.
   Head, header and footer come from one file; each page supplies its title,
   body attributes, main markup and script list. Assets are absolute because
   the pages now live at /de/karte/ instead of /index.html. #}
{%- set seo_title = page_seo.title|default('') %}{% if seo_title is empty %}{% set seo_title = 'LOTRO Log Book' %}{% elseif 'LOTRO Log Book' not in seo_title %}{% set seo_title = seo_title ~ ' – LOTRO Log Book' %}{% endif -%}
<html lang="{{ lang }}" data-sprache="{{ lang }}">
<head>
<meta charset="utf-8">
{# The application scripts load their data with relative paths ("daten-de.js").
   They used to sit at the site root; the base keeps them there. #}
<base href="/">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block seite_titel %}{{ seo_title }}{% endblock %}</title>
<meta name="description" content="{{ page_seo.description }}">
<link rel="canonical" href="{{ base }}{{ canonical_url }}">
{% for alt in alternates %}<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ base }}{{ alt.url }}">
{% endfor %}<meta property="og:type" content="website">
<meta property="og:site_name" content="LOTRO Log Book">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:description" content="{{ page_seo.description }}">
<meta property="og:url" content="{{ base }}{{ canonical_url }}">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:image" content="{{ base }}/bild/vorschau-{{ lang }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ og_image_alt }}">
<meta name="twitter:card" content="summary_large_image">
{{ tracking|raw }}
{% block stile %}{% endblock %}
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
</head>
<body{{ block('koerper_attribute') }}>

<header class="kopf">
	<div class="kopf-innen">
		<h1 data-t="produkt">LOTRO Log Book</h1>
		<nav class="menue" id="menue" aria-label="Menü"></nav>
		{% block kopf_extra %}{% endblock %}
	</div>
</header>
{% block vor_haupt %}{% endblock %}

{% block pfad %}{% if crumbs|default('') %}<div class="huelle-pfad"><nav class="katalog-pfad" aria-label="Breadcrumb">{{ crumbs|raw }}</nav></div>{% endif %}{% endblock %}
{% block haupt %}{% endblock %}

{% block fuss %}{% endblock %}
<footer class="seitenfuss">
	<div class="seitenfuss-innen">
		<div class="footer-links-links">
			<p>LOTRO Log Book</p>
			<p class="footer-statistik">
			<span data-statistik-aktiv hidden><a class="unterwegs-symbol" href="https://icons8.com/icon/TZNgFj31O74L/gandalf" target="_blank" rel="noopener" aria-label="Gandalf icon by Icons8"><img src="/bild/gandalf.png" alt=""></a><span data-statistik-aktiv-text></span></span>
			</p>
		</div>
		<nav class="sprachen" aria-label="Sprache">{% for sprache in sprachen %}<a href="{{ sprache.url }}" hreflang="{{ sprache.lang }}" lang="{{ sprache.lang }}"{% if sprache.aktiv %} aria-current="page"{% endif %}><span aria-hidden="true">{% if sprache.lang == 'de' %}🇩🇪{% elseif sprache.lang == 'en' %}🇬🇧{% else %}🇫🇷{% endif %}</span> {{ sprache.label }}</a>{% endfor %}</nav>
		<p class="footer-rechts"><a href="/{{ lang }}/plugin/">Plugin</a> · <a href="/impressum.html?lang={{ lang }}">Impressum</a> · <a href="/datenschutz.html?lang={{ lang }}">Datenschutz</a></p>
	</div>
</footer>
{# The build used to set this inline; the map reads it for its images. #}
<script>window.MQL_BILD_PFAD = 'karten/{{ lang }}/';</script>
<script src="/statistik.js?v={{ asset_stand }}" defer></script>
<script src="/sprachwahl.js?v={{ asset_stand }}" defer></script>
{% block skripte %}{% endblock %}
</body>
</html>
