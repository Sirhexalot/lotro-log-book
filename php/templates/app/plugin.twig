{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="plugin" class="seite-text"{% endblock %}

{% block haupt %}
<main class="seite">
<h2 data-t="pl_titel">Plugin fürs Spiel</h2>
	<p data-t-html="pl_einleitung"></p>
	<ul data-t-html="pl_was"></ul>

	<h2 data-t="pl_download_titel">1. Herunterladen</h2>
	<p data-t="pl_download"></p>
	<p class="zeile-knoepfe">
		<a class="knopf-gold" href="https://www.lotrointerface.com/downloads/info1346-MagicQuestLog.html" rel="noopener" target="_blank" data-t="pl_download_knopf">Magic Quest Log bei LOTROInterface</a>
	</p>

	<h2 data-t="pl_install_titel">2. Installieren</h2>
	<ol data-t-html="pl_install"></ol>
	<p class="schwach" data-t-html="pl_neustart"></p>

	<h2 data-t="pl_fortschritt_titel">3. Fortschritt übernehmen</h2>
	<p data-t-html="pl_fortschritt"></p>
	<p id="ohne-charakter">
		<span data-t="pl_ohne">Noch kein Charakter im Browser:</span>
		<a data-ziel="spielstand.html" href="spielstand.html?lang=de" data-t="menue_spielstand">Spielstand importieren</a>
	</p>
	<div class="zeile-knoepfe">
		<button type="button" class="knopf-gold" id="schreiben" data-t="pl_schreiben">In den LOTRO-Ordner schreiben</button>
		<button type="button" id="zip" data-t="pl_zip">Als Zip herunterladen</button>
	</div>
	<p class="schwach" id="schreiben-hinweis" data-t-html="pl_hinweis"></p>
	<p class="meldung" id="meldung-plugin" role="status"></p>
	<div class="kasten">
		<span class="schwach" data-t="pl_plugindata">Der Ordner „PluginData“ liegt hier (beim Schreiben genau diesen wählen):</span><br>
		Windows: <code data-t="pl_plugin_windows_path">Dokumente\The Lord of the Rings Online\PluginData</code><br>
		macOS: <code>~/Documents/The Lord of the Rings Online/PluginData</code>
	</div>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js" defer></script>
<script src="/texte-spielstand.js" defer></script>
<script src="/texte-logbuch.js" defer></script>
<script src="/texte-site.js" defer></script>
<script src="/texte-plugin.js" defer></script>
<script src="/sprache.js" defer></script>
<script src="/speicher.js" defer></script>
<script src="/menue.js" defer></script>
<script src="/companion.js" defer></script>
<script src="/plugin.js" defer></script>
{% endblock %}
