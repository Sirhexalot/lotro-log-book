{% extends 'app/layout.twig' %}

{% block koerper_attribute %} class="seite-text gs-seite" data-seite="belohnungen"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gegenstaende.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/belohnungen.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/filter-ui.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}
{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="gs belohnungen" id="belohnungen">
	<div class="gs-kopf">
		<h1 data-t="bl_titel">Belohnungen</h1>
		<p class="gs-unter" data-t="bl_text">Finde die Aufgaben und Taten, die einen Gegenstand als Belohnung vergeben.</p>
		<form class="gs-fallback" id="bl-suche" method="get" data-filter-fallback role="search">
			<input type="search" name="q" data-t-ph="bl_suche" autocomplete="off">
			<button type="submit" class="knopf" data-t="gs_suchen">Suchen</button>
		</form>
	</div>
	<div class="gs-raster">
		<button type="button" class="gs-filter-knopf" aria-expanded="false" aria-controls="bl-filter" data-t="gs_filter">Filter</button>
		<aside class="gs-filter" id="bl-filter" aria-label="Filter"></aside>
		<section class="gs-liste">
			<div class="gs-sortierung">
				<span data-t="bl_titel">Belohnungen</span>
			</div>
			<p class="gs-stand" role="status" data-t="gs_lade">Lade Belohnungen …</p>
			<ul class="gs-ergebnis bl-ergebnis" id="bl-ergebnis" data-filter-results></ul>
		</section>
	</div>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
<script src="/familienmenue.js?v={{ asset_stand }}" defer></script>
<script src="/symbole.js?v={{ asset_stand }}" defer></script>
<script src="/filtergedaechtnis.js?v={{ asset_stand }}" defer></script>
<script src="/filterzustand.js?v={{ asset_stand }}" defer></script>
<script src="/filteradapter.js?v={{ asset_stand }}" defer></script>
<script src="/filter-ui.js?v={{ asset_stand }}" defer></script>
<script src="/belohnungen.js?v={{ asset_stand }}" defer></script>
{% endblock %}
