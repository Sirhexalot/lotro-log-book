{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="karte" data-pane="liste"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/flaeche.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/fakten.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/hinweis.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/klappe.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/filter-ui.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/landschaft.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gelaende.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/epik.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}<div class="globalsuche">
			<input id="suche" type="search" data-t-ph="suche_global" placeholder="Suchen" autocomplete="off" aria-controls="suchergebnis">
			<div class="suchergebnis" id="suchergebnis" hidden></div>
		</div>{% endblock %}

{% block vor_haupt %}<nav class="mobil-reiter" id="mobil-reiter" aria-label="Ansicht">
	<button type="button" data-pane="liste" aria-pressed="true" data-t="mobil_liste">Liste</button>
	<button type="button" data-pane="karte" aria-pressed="false" data-t="mobil_karte">Karte</button>
	<button type="button" data-pane="details" aria-pressed="false" data-t="mobil_details">Details</button>
</nav>{% endblock %}

{% block pfad %}<div class="karten-pfad" hidden><nav id="karten-breadcrumb" class="katalog-pfad" aria-label="Gebiet"></nav></div>{% endblock %}

{% block haupt %}
<main class="karte-laedt">
<section id="landschaften" class="landschaften" hidden></section>
	<section class="spalte nav" id="nav">
		<div class="nav-baum">
			<div class="spalten-kopf">
				<strong data-t="gebiete">Gebiete</strong>
				<button id="zuklappen" data-t="alles_zuklappen" title="Alle Gebiete zuklappen">alles zuklappen</button>
			</div>
			<div class="baumsuche">
				<input id="gebietsuche" type="search" data-t-ph="gebiet_suchen" placeholder="Gebiet suchen" autocomplete="off">
			</div>
			<nav class="gebietsspalte" id="baum" aria-label="Gebiete"></nav>
		</div>
		<div class="nav-liste">
			<strong class="liste-titel" id="liste-titel" data-t="aufgaben">Aufgaben</strong>
			<div class="listenwerkzeuge">
				<div class="filter-kopf">
					<button type="button" id="filter-knopf" class="filter-knopf" aria-expanded="false" aria-controls="filter">
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 5h16l-6.5 7.2V18l-3 1v-6.8z"/></svg>
						<span data-t="filter">Filter</span>
						<span id="filter-anzahl" hidden></span>
					</button>
					<button type="button" id="filter-zuruecksetzen" class="filter-reset" hidden><span aria-hidden="true">×</span><span class="visuell-versteckt" data-t="filter_zuruecksetzen">zurücksetzen</span></button>
					<label class="aufgaben-suche">
						<span class="visuell-versteckt" data-t="aufgaben_suchen">Aufgaben suchen</span>
						<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
						<input id="aufgaben-suche" type="search" autocomplete="off" data-t-ph="aufgaben_suche_platzhalter" placeholder="Aufgabe oder Auftraggeber suchen">
					</label>
				</div>
				<dialog class="filter kartenfilter" id="filter" aria-labelledby="kartenfilter-titel">
					<div class="kartenfilter-kopf">
						<strong id="kartenfilter-titel" data-t="filter">Filter</strong>
						<button type="button" id="kartenfilter-schliessen"><span aria-hidden="true">×</span><span class="visuell-versteckt" data-t="kartenfilter_fertig">Fertig</span></button>
					</div>
					<div class="kartenfilter-inhalt">
					<fieldset class="kartenfilter-status" id="kartenfilter-status">
						<legend data-t="kartenfilter_fortschritt">Fortschritt</legend>
						<label><input type="radio" name="kartenfortschritt" value="alle" checked><span data-t="filter_alle">Alle</span><small class="kartenfilter-zahl" data-filterzahl="alle" hidden></small></label>
						<label><input type="radio" name="kartenfortschritt" value="offen"><span data-t="filter_offen">Nicht begonnen</span><small class="kartenfilter-zahl" data-filterzahl="offen" hidden></small></label>
						<label><input type="radio" name="kartenfortschritt" value="laufend"><span data-t="filter_laufend">Begonnen</span><small class="kartenfilter-zahl" data-filterzahl="laufend" hidden></small></label>
						<label><input type="radio" name="kartenfortschritt" value="erledigt"><span data-t="filter_erledigt">Erledigt</span><small class="kartenfilter-zahl" data-filterzahl="erledigt" hidden></small></label>
						<label id="filter-machbar" hidden><input type="radio" name="kartenfortschritt" value="machbar" aria-labelledby="kartenfilter-machbar-titel" aria-describedby="kartenfilter-machbar-hilfe"><span><span id="kartenfilter-machbar-titel" data-t="filter_machbar">Voraussetzungen erfüllt</span><small id="kartenfilter-machbar-hilfe" data-t="kartenfilter_machbar_hilfe">Aufgaben, die du noch nicht begonnen hast und deren bekannte Voraussetzungen du erfüllst.</small></span><small class="kartenfilter-zahl" data-filterzahl="machbar" hidden></small></label>
					</fieldset>
					<label class="belohnungsfilter" id="belohnungsfilter-feld" hidden>
						<span data-t="belohnung">Belohnung</span>
						<select id="belohnungsfilter">
							<option value="alle" data-t="belohnung_alle">alle</option>
							<option value="tugend" data-t="belohnung_tugend">Tugend</option>
							<option value="titel" data-t="belohnung_titel">Titel</option>
							<option value="punkte" data-t="belohnung_punkte">LOTRO-Punkte</option>
						</select>
					</label>
					</div>
					<div class="kartenfilter-fuss">
						<button type="button" id="kartenfilter-reset" data-t="filter_zuruecksetzen">Zurücksetzen</button>
						<button type="button" id="kartenfilter-fertig" data-t="kartenfilter_fertig">Fertig</button>
					</div>
				</dialog>
			</div>
			<ol id="liste"></ol>
		</div>
	</section>

	<section class="kartenspalte">
		<nav id="landschaft-orte" class="landschaft-orte" aria-label="Karten"></nav>
		<div class="buehne" id="buehne">
			<div class="welt" id="welt">
				<img id="bild" alt="" width="1024" height="768" decoding="async" fetchpriority="high">
				<div class="raster" id="raster"></div>
				<div class="marker" id="marker"></div>
			</div>
			<p class="kartenhinweis" id="hinweis" role="status"></p>
			<div class="kartenkopf">
				<div class="kartenkopf-links">
					<div class="notizen" id="notizen">
						<button type="button" id="notizen-knopf" aria-expanded="false" aria-controls="notizen-feld" data-t="notizen">Filter</button>
						<div class="notizen-feld llb-klappe-feld" id="notizen-feld" hidden>
							<div class="notizen-alle"><button type="button" id="notizen-alle" data-t="notizen_alle">Alle auswählen</button><button type="button" id="notizen-keine" data-t="notizen_keine">Alles löschen</button></div>
							<ul id="notizen-liste"></ul>
						</div>
					</div>
					<div class="notizen" id="vorkommen">
						<button type="button" id="vorkommen-knopf" aria-expanded="false" aria-controls="vorkommen-feld" data-t="vorkommen">Vorkommen</button>
						<div class="notizen-feld vorkommen-feld llb-klappe-feld" id="vorkommen-feld" hidden>
							<div class="notizen-alle"><button type="button" id="vorkommen-alle" data-t="notizen_alle">Alle auswählen</button><button type="button" id="vorkommen-keine" data-t="notizen_keine">Alles löschen</button></div>
							<div id="vorkommen-liste" class="vorkommen-zeilen"></div>
						</div>
					</div>
					<button type="button" class="geber-schalter" id="geber-schalter" aria-pressed="true" data-t="aufgabenfuehrer">Questgeber anzeigen</button>
				</div>
				<div class="kartenkopf-rechts">
					<div class="kartenansicht" id="kartenansicht" role="group" aria-label="Kartenansicht" hidden>
						<button type="button" data-kartenansicht="gelaende" aria-pressed="false">Gelände</button>
						<button type="button" data-kartenansicht="karte" aria-pressed="true">Spielkarte</button>
					</div>
					<div class="gelaende-zoom" id="gelaende-zoom" hidden>
						<button type="button" data-zoom="in">+</button><button type="button" data-zoom="out">−</button><button type="button" data-zoom="fit">⌖</button>
					</div>
				</div>
			</div>
		</div>
		<div class="kartenleiste">
			<span id="karte-stufe" class="karte-stufe" hidden></span>
			<div class="legende-zeile">
				<div class="legende" id="legende" hidden>
					<span class="legende-eintrag"><i class="legende-symbol"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="5"/><path d="M20 21a8 8 0 0 0-16 0"/></svg></i><span data-t="legende_auftraggeber">Kreis: Auftraggeber</span></span>
					<span class="legende-eintrag"><i class="legende-symbol hohl"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="22" x2="18" y1="12" y2="12"/><line x1="6" x2="2" y1="12" y2="12"/><line x1="12" x2="12" y1="6" y2="2"/><line x1="12" x2="12" y1="22" y2="18"/></svg></i><span data-t="legende_ziel">Kreis offen: erstes Ziel</span></span>
					<span class="legende-fortschritt"><i class="tupfen offen"></i><span data-t="legende_offen">nicht begonnen</span></span>
					<span class="legende-fortschritt"><i class="tupfen fertig"></i><span data-t="legende_erledigt">erledigt</span></span>
					<span class="legende-fortschritt" id="legende-teils" hidden><i class="tupfen teils"></i><span data-t="legende_teils">teils erledigt</span></span>
					<span class="legende-fortschritt" id="legende-laufend" hidden><i class="tupfen laufend"></i><span data-t="in_arbeit">begonnen</span></span>
					<span class="legende-eintrag" id="legende-ziele" hidden><i class="legende-symbol ring"></i><span data-t="legende_ziele">Ring mit Nummer: Ziel der gewählten Aufgabe</span></span>
					<span class="legende-eintrag" id="legende-jagd" hidden><i class="legende-symbol gestrichelt"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="4" r="2"/><circle cx="18" cy="8" r="2"/><circle cx="20" cy="16" r="2"/><path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z"/></svg></i><span data-t="legende_jagd">Gestrichelt: möglicher Jagdort (Tat)</span></span>
					<span class="legende-eintrag" id="legende-aufgabenort" hidden><i class="legende-symbol gepunktet"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 12h-5"/><path d="M15 8h-5"/><path d="M19 17V5a2 2 0 0 0-2-2H4"/><path d="M8 21h12a2 2 0 0 0 2-2v-1a1 1 0 0 0-1-1H11a1 1 0 0 0-1 1v1a2 2 0 1 1-4 0V5a2 2 0 1 0-4 0v2a1 1 0 0 0 1 1h3"/></svg></i><span data-t="legende_aufgabenort">Gepunktet: Ort der zugehörigen Aufgaben (Tat)</span></span>
					<span class="legende-eintrag" id="legende-vorkommen" hidden></span>
				</div>
				<button type="button" class="legende-mehr aus" id="legende-mehr" aria-expanded="false" aria-controls="legende-voll" aria-label="Ganze Zeichenerklärung" title="Ganze Zeichenerklärung">?</button>
				<div class="legende-voll llb-klappe-feld" id="legende-voll" hidden></div>
			</div>
			<div class="leiste-aktionen">
				<button type="button" id="gebietskarte" class="gebietskarte" hidden></button>
				<span class="leiste-rechts"><span id="koordinate" class="koordinate"></span></span>
				<span class="gelaende-status" id="gelaende-status" role="status"></span>
			</div>
		</div>
	</section>

	<section class="spalte detail" id="detail">
		<p class="leer" data-t="detail_leer">Links ein Gebiet wählen, dann auf der Karte einen Punkt anklicken.</p>
	</section>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/klappe.js?v={{ asset_stand }}" defer></script>
<script src="/gelaende.js?v={{ asset_stand }}" defer></script>
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/symbole.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/speicher.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
<script src="/familienmenue.js?v={{ asset_stand }}" defer></script>
{% endblock %}
