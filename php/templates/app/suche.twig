{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="suche" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite">
<h2 data-t="su_titel">Suche</h2>
	<p data-t="su_text">Aufgaben, Taten, Titel, Gegenstände und Rezepte in einem Feld.</p>
	<div class="suche-feld">
		<input type="search" id="su-feld" data-t-ph="su_platzhalter" autocomplete="off" autofocus>
		<span class="stufe-klein" id="su-anzahl" role="status"></span>
	</div>
	<p class="schwach" id="su-hinweis" data-t="su_min">Mindestens zwei Zeichen.</p>
	<div id="su-liste"></div>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js" defer></script>
<script src="/texte-spielstand.js" defer></script>
<script src="/texte-logbuch.js" defer></script>
<script src="/texte-site.js" defer></script>
<script src="/symbole.js" defer></script>
<script src="/sprache.js" defer></script>
<script src="/speicher.js" defer></script>
<script src="/menue.js" defer></script>
<script src="/suche.js" defer></script>
{% endblock %}
