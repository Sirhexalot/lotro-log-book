{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="reise" class="seite-text"{% endblock %}

{% block haupt %}
<main class="seite">
<h2 data-t="reise_titel">Reise</h2>
	<p data-t="reise_einleitung"></p>

	<form class="reise-formular" id="reise-formular" autocomplete="off">
		<div class="reise-feld">
			<label for="reise-von" data-t="reise_von">Wo bin ich?</label>
			<input id="reise-von" type="text" data-t-ph="reise_von_platz" aria-autocomplete="list" aria-controls="reise-von-liste">
			<ul class="reise-vorschlaege" id="reise-von-liste" hidden></ul>
		</div>
		<div class="reise-feld">
			<label for="reise-nach" data-t="reise_nach">Wohin?</label>
			<input id="reise-nach" type="text" data-t-ph="reise_nach_platz" aria-autocomplete="list" aria-controls="reise-nach-liste">
			<ul class="reise-vorschlaege" id="reise-nach-liste" hidden></ul>
		</div>
		<div class="reise-zeile">
			<button type="submit" class="reise-knopf" data-t="reise_knopf">Weg zeigen</button>
		</div>
	</form>

	<p class="reise-hilfe" data-t-html="reise_von_hilfe"></p>
	<p class="reise-zeile">
		<button type="button" class="reise-leise" id="reise-tauschen" data-t="reise_tauschen">Start und Ziel tauschen</button>
		<button type="button" class="reise-leise" id="reise-beispiel" data-t="reise_beispiel_knopf">Beispiel laden</button>
	</p>

	<section id="reise-ergebnis" class="reise-block" aria-live="polite"></section>

	<section class="reise-block">
		<h3 data-t="reise_klasse">Deine Klassenports</h3>
		<p class="reise-hilfe" data-t="reise_klasse_hinweis"></p>
		<div class="reise-zeile">
			<label for="reise-klasse" class="reise-hilfe" data-t="reise_klasse_waehlen">Klasse</label>
			<select id="reise-klasse" class="reise-klasse"></select>
		</div>
		<ul class="reise-ports" id="reise-ports"></ul>
	</section>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js" defer></script>
<script src="/texte-spielstand.js" defer></script>
<script src="/texte-logbuch.js" defer></script>
<script src="/texte-site.js" defer></script>
<script src="/texte-reise.js" defer></script>
<script src="/sprache.js" defer></script>
<script src="/speicher.js" defer></script>
<script src="/menue.js" defer></script>
<script src="/reise.js" defer></script>
{% endblock %}
