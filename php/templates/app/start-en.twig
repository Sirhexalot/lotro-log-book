{% extends 'app/layout.twig' %}

{% block koerper_attribute %} class="seite-start landing" data-seite="start"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/start.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main>
<section class="hero">
	<p class="dach">The Lord of the Rings Online</p>
	<h2>Your companion through <em>Middle-earth</em>.</h2>
	<p class="lead">Another chapter of the story, an unfinished deed or a rare recipe to find? Open your log book. Look up quests and items, find your way across the lands and import your progress to keep track of your characters’ adventures.</p>
	<form class="suche-start" action="/en/search/" method="get" role="search">
		<label class="nur-leser" for="start-suche">Search the log book</label>
		<input id="start-suche" type="search" name="q" placeholder="Quest, item, title or destination" autocomplete="off">
		<button type="submit" class="knopf">Search</button>
	</form>
	<p class="einstieg">
		<a class="knopf" href="/en/map/">Open the map</a>
		<a class="knopf sekundaer" href="/en/progress/">Import progress</a>
	</p>
</section>

<ul class="zahlen" aria-label="Size of the catalogue">
	<li><span data-katalogzahl="aufgaben">15,118</span><small>Quests</small></li>
	<li><span data-katalogzahl="taten">5,528</span><small>Deeds</small></li>
	<li><span data-katalogzahl="gegenstaende">52,798</span><small>Items</small></li>
	<li><span data-katalogzahl="rezepte">7,924</span><small>Recipes</small></li>
	<li><span data-katalogzahl="titel">2,442</span><small>Titles</small></li>
	<li><span data-katalogzahl="tugenden">20</span><small>Virtues</small></li>
	<li><span data-katalogzahl="stationen">372</span><small>Travel stations</small></li>
</ul>

<section class="familien" aria-labelledby="familien-titel">
	<h3 id="familien-titel">Where will you go next?</h3>
	<div class="familien-karten">
		<article class="familie-karte">
			<h4><a href="/en/map/">World</a></h4>
			<p>Follow the epic story or see what awaits you off the beaten path.</p>
			<ul>
				<li><a href="/en/map/">Quests</a>: explore the lands, follow the books</li>
				<li><a href="/en/map/deeds/">Deeds</a>: what to do and what you still need</li>
				<li><a href="/en/travel/">Travel</a>: find your route from stable to stable</li>
			</ul>
		</article>
		<article class="familie-karte">
			<h4><a href="/en/item-search/">Items</a></h4>
			<p>A better bow, wood for the workbench or something for the cooking pot? Look it up here.</p>
			<ul>
				<li><a href="/en/item-search/">Items</a>: compare stats and find where to get them</li>
				<li><a href="/en/crafting/recipes/">Crafting</a>: recipes, ingredients and resources</li>
				<li><a href="/en/crafting/recipes/">Professions</a>: from your first attempts to mastery</li>
			</ul>
		</article>
		<article class="familie-karte">
			<h4><a href="/en/rewards/">Rewards</a></h4>
			<p>A new title or a stronger virtue: find something worth setting out for.</p>
			<ul>
				<li><a href="/en/rewards/">Rewards</a>: what your quests and deeds bring you</li>
				<li><a href="/en/title/">Titles</a>: how to earn them</li>
				<li><a href="/en/virtue/">Virtues</a> and <a href="/en/reputation/">reputation</a>: choose your next goal</li>
			</ul>
		</article>
		<article class="familie-karte">
			<h4><a href="/en/progress/">Your character</a></h4>
			<p>You have come a long way. Keep track of your adventures and your craft.</p>
			<ul>
				<li><a href="/en/progress/">Import progress</a>: bring your adventures into the log book</li>
				<li><a href="/en/crafting/recipes/">My professions</a>: what you know and what to learn next</li>
				<li><a href="/en/reputation/">My reputation</a>: where you have made a name for yourself</li>
			</ul>
		</article>
	</div>
</section>

<section class="neuigkeiten" aria-labelledby="neu-titel">
	<h3 id="neu-titel">New in the log book</h3>
	<article class="neuigkeit">
		<p class="datum"><time datetime="2026-11-09">9 November 2026</time></p>
		<h4>Find the recipe you need</h4>
		<p>Search by result or ingredient and filter recipes by profession, crafting tier and category. With imported recipe knowledge, you can hide recipes you already know. <a href="/en/crafting/recipes/">Browse crafting</a></p>
	</article>
	<article class="neuigkeit">
		<p class="datum"><time datetime="2026-11-09">9 November 2026</time></p>
		<h4>Where can I find wood and ore?</h4>
		<p>Open “Where can I get this?” beside an ingredient to see recorded gathering areas with map links, or the recipes that make boards and ingots. <a href="/en/crafting/recipes/#rohstoffe">Look up resources</a></p>
	</article>
	<article class="neuigkeit">
		<p class="datum"><time datetime="2026-11-09">9 November 2026</time></p>
		<h4>Your progress, fewer steps</h4>
		<p>Choose your Companion folder to import your characters. Instructions are linked when you need them, and your existing characters appear just below. <a href="/en/progress/">Import progress</a></p>
	</article>
</section>

<figure class="bild">
	<a href="/en/map/"><img src="bild/start-en.jpg" alt="Quest map of Bree-land in LOTRO Log Book" loading="lazy" width="1280" height="860"></a>
	<figcaption>Out and about in Bree-land: find quests and plan your next journey.</figcaption>
</figure>

<section class="import" aria-labelledby="import-titel">
	<h3 id="import-titel">With your own progress</h3>
	<p>You have travelled many roads already. Bring your progress over with LOTRO Companion to see the quests and deeds you have completed, the recipes you know and your standing with each faction. Your character data stays on your computer.</p>
	<p><a class="knopf sekundaer" href="/en/progress/">Import progress</a> <a href="/en/companion/">How to use LOTRO Companion</a></p>
</section>

<section class="plugin" aria-labelledby="plugin-titel">
	<h3 id="plugin-titel">Also in game: Magic Quest Log</h3>
	<p>The companion plugin shows quests, deeds and your progress inside LOTRO. You do not need it for this website.</p>
	<p><a class="knopf sekundaer" href="/en/plugin/">In-game plugin</a></p>
</section>

<section class="feedback">
	<h3>Found something wrong?</h3>
	<p>A missing quest, a wrong turn or something not working? Write to <a href="mailto:llb@sirhexalot.de">llb@sirhexalot.de</a> or report it on <a href="https://github.com/Sirhexalot/lotro-log-book/issues" rel="noopener" target="_blank">GitHub</a>.</p>
</section>
</main>
{% endblock %}

{% block fuss %}<footer><p>LOTRO Log Book · <a href="/impressum.html?lang=en">Legal notice</a> · <a href="/datenschutz.html?lang=en">Privacy</a></p></footer>{% endblock %}

{% block skripte %}
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/speicher.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
{% endblock %}
