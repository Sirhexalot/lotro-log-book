{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="spielstand" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}
{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite import-seite">
	<h2 data-t="sp_titel">Spielstand importieren</h2>
	<p data-t="sp_einleitung"></p>
	<div class="ablage" id="ablage">
		<input id="ordner" type="file" webkitdirectory directory multiple hidden>
		<button type="button" class="knopf-gold" id="ordner-waehlen" data-t="sp_ordner_waehlen">Companion-Ordner auswählen</button>
		<p class="schwach" data-t="sp_ablage">Oder den Ordner „characters“ hierher ziehen</p>
	</div>
	<p class="meldung" id="meldung" role="status"></p>
	<p data-t-html="sp_hilfe_companion"></p>
	<details class="import-ordnerhilfe">
		<summary data-t="sp_ordner_hilfe">Wo finde ich den Ordner?</summary>
		<p data-t="sp_laden"></p>
		<div class="reiter" role="tablist">
			<button type="button" data-reiter="windows" aria-pressed="true">Windows</button>
			<button type="button" data-reiter="mac" aria-pressed="false">macOS</button>
		</div>
		<div data-inhalt="windows">
			<p data-t="sp_ordner_windows"></p>
			<code>%USERPROFILE%\.lotrocompanion\data\characters</code>
		</div>
		<div data-inhalt="mac" hidden>
			<p data-t="sp_ordner_mac"></p>
			<code>~/Applications/The Lord of the Rings Online.app/Contents/SharedSupport/prefix/drive_c/users/Wineskin/.lotrocompanion/data/characters</code>
		</div>
	</details>

	<section id="charaktere" hidden>
		<h2 data-t="sp_schritt3">Deine Charaktere</h2>
		<div class="tabellen-rahmen"><table class="tabelle" id="tabelle">
			<thead><tr>
				<th data-t="sp_spalte_name">Name</th>
				<th data-t="sp_spalte_server">Server</th>
				<th data-t="sp_spalte_klasse">Klasse</th>
				<th class="zahl" data-t="sp_spalte_stufe">Stufe</th>
				<th class="zahl" data-t="sp_spalte_aufgaben">Aufgaben</th>
				<th class="zahl" data-t="sp_spalte_taten">Taten</th>
				<th data-t="sp_spalte_stand">Stand</th>
				<th></th>
			</tr></thead>
			<tbody id="zeilen"></tbody>
		</table></div>
		<div id="import-fertig" hidden>
			<button type="button" id="fertig-karte" data-t="sp_zur_karte">Zur Karte</button>
		</div>
	</section>

	<details class="import-verwaltung">
		<summary data-t="sp_verwalten">Charaktere verwalten</summary>
		<p data-t="sp_sichern"></p>
		<div class="zeile-knoepfe">
			<button type="button" id="sicherung" data-t="sp_sicherung" hidden>Sicherung herunterladen</button>
			<button type="button" id="sicherung-laden" data-t="sp_sicherung_laden">Sicherung laden …</button>
			<input id="sicherung-datei" type="file" accept=".json,application/json" hidden>
		</div>
		<p class="meldung" id="meldung-sicherung" role="status"></p>
	</details>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/speicher.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
<script src="/companion.js?v={{ asset_stand }}" defer></script>
<script src="/spielstand.js?v={{ asset_stand }}" defer></script>
{% endblock %}
