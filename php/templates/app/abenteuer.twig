{% extends 'app/layout.twig' %}
{# Adventure overview: every adventure is readable without JavaScript. The
   character's progress, the two suggestions and the ownership settings are
   filled in by abenteuer.js from local data only. #}
{% block koerper_attribute %} data-seite="abenteuer" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/abenteuer.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite abenteuer">
	<div class="abenteuer-kopf">
		<p class="dach">LOTRO Log Book · {{ lw.title }}</p>
		<h2>{{ lw.title }}</h2>
		<p class="abenteuer-intro">{{ lw.intro }}</p>
		<p class="abenteuer-charakter" id="abenteuer-charakter" data-leer="{{ lw.no_character }}">
			{{ lw.no_character }} <a href="{{ spielstand_pfad }}">{{ lw.import_link }}</a>
		</p>
	</div>

	<section class="abenteuer-hinweise" id="hinweise" aria-live="polite" data-liste="{{ lw.adventures }}">
		<article class="hinweis" data-hinweis="finish" hidden>
			<p class="hinweis-art">{{ lw.finish }}</p>
			<h3 data-hinweis-titel></h3>
			<p class="hinweis-text" data-hinweis-text></p>
			<button type="button" class="hinweis-link" data-hinweis-ziel hidden></button>
		</article>
		<article class="hinweis" data-hinweis="level" hidden>
			<p class="hinweis-art">{{ lw.level }}</p>
			<h3 data-hinweis-titel></h3>
			<p class="hinweis-text" data-hinweis-text></p>
			<button type="button" class="hinweis-link" data-hinweis-ziel hidden></button>
		</article>
		<p class="hinweis-leer" id="hinweis-leer" hidden>{{ lw.import_hint }} <a href="{{ spielstand_pfad }}">{{ lw.import_link }}</a></p>
	</section>

	<div class="abenteuer-liste-kopf">
		<h3>{{ lw.adventures }}</h3>
		<p>{{ lw.adventures_hint }}</p>
	</div>

	<details class="abenteuer-inhalte" id="inhalte">
		<summary>{{ lw.content_link }}</summary>
		<p class="schwach">{{ lw.content_hint }}</p>
		<div class="inhalte-aktionen">
			<button type="button" data-alle="owned">{{ lw.all_owned }}</button>
			<button type="button" data-alle="missing">{{ lw.all_missing }}</button>
			<span class="inhalte-status" data-status role="status"></span>
		</div>
		<ul class="inhalte-liste">
			{% for pack in packs %}
			<li data-inhalt-zeile="{{ pack.id }}">
				{% if pack.emblem %}<img class="inhalt-sigel" src="{{ pack.emblem }}" alt="" width="26" height="26" loading="lazy">{% endif %}
				<label class="inhalt-name" for="inhalt-{{ pack.id }}">{{ pack.name }}</label>
				<span class="inhalt-stand" data-inhalt-stand="{{ pack.id }}"></span>
				<select id="inhalt-{{ pack.id }}" data-inhalt="{{ pack.id }}"{% if pack.free|default(false) %} data-frei="1"{% endif %}>
					<option value="unknown" selected>{{ lw.unknown }}</option>
					<option value="owned">{{ lw.owned }}</option>
					<option value="missing">{{ lw.missing }}</option>
				</select>
			</li>
			{% endfor %}
		</ul>
	</details>

	<div class="abenteuer-raster" id="abenteuer-raster">
		{% for pack in packs %}
		<article class="abenteuer-karte" data-pack="{{ pack.id }}" data-stufe-min="{{ pack.level_min }}" data-stufe-max="{{ pack.level_max }}">
			<div class="karte-oben">
				{% if pack.emblem %}<img class="karte-sigel" src="{{ pack.emblem }}" alt="" width="56" height="56" loading="lazy">{% endif %}
				<div class="karte-titel">
					<h3>{{ pack.name }}</h3>
					<p class="karte-art">{{ pack.type_label }} · {{ pack.level_label }}</p>
				</div>
			</div>
			<p class="karte-text">{{ pack.summary }}</p>
			<p class="karte-stand" data-stand><span data-stand-wort></span></p>
			<div class="karte-balken" data-balken hidden><span></span></div>
			<p class="karte-detail" data-detail hidden></p>
			<p class="karte-zugang" data-zugang hidden></p>
			<button type="button" class="karte-mehr" data-mehr aria-expanded="false" aria-controls="gebiete-{{ pack.id }}">{{ lw.open }}</button>
			<div class="karte-gebiete" id="gebiete-{{ pack.id }}" data-gebiete hidden>
				<h4>{{ lw.areas }}</h4>
				{% if pack.areas_list %}
				<ul>
					{% for area in pack.areas_list %}{% if area.name %}
					<li data-gebiet="{{ area.id }}" data-aufgaben="{{ area.quests }}"><span>{{ area.name }}</span><small>{{ (area.quests == 1 ? lw.quests_one : lw.quests)|replace({'%s': area.quests}) }}</small><em data-gebiet-stand></em></li>
					{% endif %}{% endfor %}
				</ul>
				{% else %}<p class="schwach">{{ lw.no_areas }}</p>{% endif %}
			</div>
		</article>
		{% endfor %}
	</div>

	<p class="abenteuer-fussnote">{{ lw.footnote }}</p>
	<p class="abenteuer-fussnote">{{ lw.content_hint }}</p>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-abenteuer.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/speicher.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
<script src="{{ catalogue_url }}?v={{ asset_stand }}" defer></script>
<script src="/abenteuer-logik.js?v={{ asset_stand }}" defer></script>
<script src="/abenteuer.js?v={{ asset_stand }}" defer></script>
{% endblock %}
