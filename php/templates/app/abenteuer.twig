{% extends 'app/layout.twig' %}
{# Adventure overview: every adventure is readable without JavaScript. The
   character's progress, the two suggestions and the ownership settings are
   filled in by abenteuer.js from local data only. #}
{% block koerper_attribute %} data-seite="abenteuer" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/abenteuer.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite abenteuer">
	<div class="abenteuer-kopf">
		<h2>{{ lw.title }}</h2>
		<p class="abenteuer-intro">{{ lw.intro }}</p>
		<p class="abenteuer-charakter" id="abenteuer-charakter" data-leer="{{ lw.no_character }}">
			{{ lw.no_character }} <a href="{{ spielstand_pfad }}">{{ lw.import_link }}</a>
		</p>
	</div>

	<details class="abenteuer-inhalte" id="inhalte">
		<summary>{{ lw.content_link }}</summary>
		<div class="inhalte-aktionen">
			<button type="button" data-alle="owned">{{ lw.all_owned }}</button>
			<button type="button" data-alle="missing">{{ lw.all_missing }}</button>
			<span class="inhalte-status" data-status role="status"></span>
		</div>
		<ul class="inhalte-liste">
			{% for pack in packs %}{% if not pack.free|default(false) %}
			<li data-inhalt-zeile="{{ pack.id }}">
				<label class="inhalt-name" for="inhalt-{{ pack.id }}">{{ pack.name }} · {{ pack.type_label }}</label>
				<span class="inhalt-stand" data-inhalt-stand="{{ pack.id }}"></span>
				<select id="inhalt-{{ pack.id }}" data-inhalt="{{ pack.id }}">
					<option value="unknown" selected>{{ lw.unknown }}</option>
					<option value="owned">{{ lw.owned }}</option>
					<option value="missing">{{ lw.missing }}</option>
				</select>
			</li>
			{% endif %}{% endfor %}
		</ul>
	</details>

	<section class="abenteuer-hinweise" id="hinweise" aria-live="polite" data-liste="{{ lw.adventures }}">
		<article class="hinweis" data-hinweis="finish" hidden>
			<p class="hinweis-art">{{ lw.finish }}</p>
			<h3 data-hinweis-titel></h3>
			<p class="hinweis-text" data-hinweis-text></p>
			<button type="button" class="hinweis-link" data-hinweis-ziel hidden></button>
			<button type="button" class="hinweis-karte" data-hinweis-karte hidden>{{ lw.map_show }}</button>
		</article>
		<article class="hinweis" data-hinweis="level" hidden>
			<p class="hinweis-art">{{ lw.level }}</p>
			<h3 data-hinweis-titel></h3>
			<p class="hinweis-text" data-hinweis-text></p>
			<button type="button" class="hinweis-link" data-hinweis-ziel hidden></button>
			<button type="button" class="hinweis-karte" data-hinweis-karte hidden>{{ lw.map_show }}</button>
		</article>
		<p class="hinweis-leer" id="hinweis-leer" hidden>{{ lw.import_hint }} <a href="{{ spielstand_pfad }}">{{ lw.import_link }}</a></p>
	</section>

	<section class="abenteuer-welt" id="abenteuer-welt" hidden data-welt-sprache="{{ lang }}" data-karte="{{ karte_pfad }}">
		<div class="welt-welt" data-welt>
			<div class="welt-kopf">
				<h3>{{ lw.map_title }}</h3>
				<p class="schwach">{{ lw.map_hint }}</p>
			</div>
			<figure class="weltkarte">
				<img src="{{ weltkarte }}" alt="{{ lw.map_title }}" width="1024" height="768" loading="lazy" decoding="async">
				<div class="welt-marken">
					{% for region in regions %}<button type="button" class="welt-marke" data-region="{{ region.id }}" style="left: {{ region.x }}%; top: {{ region.y }}%" aria-pressed="false"><span class="welt-ring" data-ring></span><span class="welt-text"><strong>{{ region.name }}</strong><small data-wert></small></span></button>{% endfor %}
				</div>
			</figure>
			<p class="welt-legende schwach">{{ lw.map_legend }}</p>
		</div>
		<div class="welt-region" data-regionansicht hidden>
			<p class="region-zurueck"><button type="button" class="region-zurueck-knopf" data-zurueck>‹ {{ lw.map_regions }}</button></p>
			<div class="region-kopf"><h3 data-region-titel></h3><p class="schwach" data-region-summe></p></div>
			<div class="region-raster">
			<figure class="region-karte">
				<img data-region-bild alt="" width="1024" height="768" decoding="async">
				<div class="region-marken" data-region-marken></div>
			</figure>
			<section class="region-liste" aria-label="{{ lw.map_areas_list }}"><div class="cluster-kopf" data-cluster-kopf hidden></div><h4>{{ lw.map_areas_list }}</h4><div class="gebiet-sortierung" data-gebiet-sortierung></div><ul data-gebiete></ul></section>
			</div>
			<div class="welt-vorschau" data-vorschau hidden>
				<figure class="welt-bild"><img data-bild alt="" loading="lazy" decoding="async"><figcaption data-bild-name></figcaption></figure>
				<div class="welt-detail">
					<h3 data-vorschau-titel></h3>
					<p class="schwach" data-vorschau-meta></p>
					<p data-vorschau-text></p>
					<div class="welt-knoepfe"><a class="welt-knopf" data-karte-link>{{ lw.map_open }}</a><a class="welt-knopf zweit" data-gebiet-link>{{ lw.map_area }}</a></div>
					<p class="schwach">{{ lw.map_tip }}</p>
				</div>
			</div>
			<p class="welt-legende schwach">{{ lw.map_region_legend }}</p>
		</div>
	</section>
	<script type="application/json" id="abenteuer-gebieteseiten">{{ area_pages|json_encode|raw }}</script>
	<script type="application/json" id="abenteuer-kartennamen">{{ map_names|json_encode|raw }}</script>

</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-abenteuer.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/speicher.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
<script src="/familienmenue.js?v={{ asset_stand }}" defer></script>
<script src="{{ catalogue_url }}?v={{ asset_stand }}" defer></script>
<script src="/abenteuer-logik.js?v={{ asset_stand }}" defer></script>
<script src="/abenteuer.js?v={{ asset_stand }}" defer></script>
<script src="/abenteuer-karte.js?v={{ asset_stand }}" defer></script>
{% endblock %}
