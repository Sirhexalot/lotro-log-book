{% extends 'app/layout.twig' %}

{% block koerper_attribute %} data-seite="handwerk" class="seite-text"{% endblock %}

{% block stile %}<link rel="stylesheet" href="/style.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/gemeinsam.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/handwerk.css?v={{ asset_stand }}">
<link rel="stylesheet" href="/filter-ui.css?v={{ asset_stand }}">{% endblock %}

{% block kopf_extra %}{% endblock %}

{% block vor_haupt %}{% endblock %}

{% block haupt %}
<main class="seite handwerk-seite">
<h2 data-t="hw_titel">Handwerk</h2>
	<div class="reiter" role="tablist" id="hw-reiter">
		<button type="button" data-hw="berufe" aria-pressed="true" data-t="hw_berufe">Berufe</button>
		<button type="button" data-hw="rezepte" aria-pressed="false" data-t="hw_rezepte">Rezepte</button>
		<button type="button" data-hw="rohstoffe" aria-pressed="false" data-t="hw_rohstoffe">Rohstoffe</button>
	</div>
	<p class="handwerk-einleitung" id="hw-einleitung" data-t="hw_text"></p>

	<section id="hw-berufe">
		<p class="meldung" id="hinweis"></p>
		<div id="berufe"></div>
	</section>

	<section id="hw-rezepte" hidden>
		<span id="rezepte" class="handwerk-anker" aria-hidden="true"></span>
		<div id="rezepte-liste"></div>
	</section>

	<section id="hw-rohstoffe" hidden>
		<span id="rohstoffe" class="handwerk-anker" aria-hidden="true"></span>
		<div id="rohstoffe-liste"></div>
	</section>
</main>
{% endblock %}

{% block fuss %}{% endblock %}

{% block skripte %}
<script type="application/json" id="craft-geography">{{ craft_geography_json|raw }}</script>
<script type="application/json" id="craft-symbols">{{ craft_icons_json|raw }}</script>
<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/speicher.js?v={{ asset_stand }}" defer></script>
<script src="/menue.js?v={{ asset_stand }}" defer></script>
<script src="/familienmenue.js?v={{ asset_stand }}" defer></script>
<script src="/filtergedaechtnis.js?v={{ asset_stand }}" defer></script>
<script src="/referenz.js?v={{ asset_stand }}" defer></script>
<script src="/filterzustand.js?v={{ asset_stand }}" defer></script>
<script src="/filteradapter.js?v={{ asset_stand }}" defer></script>
<script src="/filter-ui.js?v={{ asset_stand }}" defer></script>
<script src="/handwerk-filter.js?v={{ asset_stand }}" defer></script>
<script src="/handwerk.js?v={{ asset_stand }}" defer></script>
<script>window.MQL_ZUTATEN_OHNE = {{ zutaten_ohne_json|raw }};</script>
<script src="/zutaten.js?v={{ asset_stand }}" defer></script>
<script src="/rezepte.js?v={{ asset_stand }}" defer></script>
<script src="/rohstoffe.js?v={{ asset_stand }}" defer></script>
{% endblock %}
