{% extends 'layout.twig' %}
{% import 'components/karte.twig' as karte %}
{% import 'components/fakten.twig' as fakten %}
{% import 'components/flaeche.twig' as flaeche %}
{% import 'components/reiter.twig' as reiter %}
{% import 'entity/_header.twig' as heading %}
{% import 'entity/_result_row.twig' as result %}

{# Instance page: the parameters a player needs first, then the geography, the
   description, who waits inside and what the instance yields. Chips carry the
   parameters; the facts raster carries the geography. The interior map is an
   illustration, not a place cut. Bosses and enemies stay folded against
   spoilers. The three relation lists are tabs; the bar ships hidden and every
   list stays readable without JavaScript. #}
{% block inhalt %}
<article class="instanz-detail entity-detail-layout">
    {{ heading.detail('instance', lang, w, page.name, symbol('instance'), '', '', '', '') }}
    {% set chips = [] %}
    {% set geografie = [] %}
    {% for fact in page.facts|default([]) %}
        {% if fact.value != page.cluster|default('') %}
            {% if fact.url|default('') %}
                {% set geografie = geografie|merge([{'label': fact.label, 'text': fact.value, 'url': fact.url}]) %}
            {% else %}
                {% set chips = chips|merge([fact.label ~ ' ' ~ fact.value]) %}
            {% endif %}
        {% endif %}
    {% endfor %}
    {% if page.cluster|default('') or chips %}
    <ul class="katalog-metazeile katalog-chips">
        {% if page.cluster|default('') %}<li class="katalog-chip">{{ page.cluster }}</li>{% endif %}
        {% for chip in chips %}<li class="katalog-chip">{{ chip }}</li>{% endfor %}
    </ul>
    {% endif %}
    {% if geografie %}{{ fakten.liste(geografie) }}{% endif %}
    {% if page.description %}
    {% set inhalt %}<p class="katalog-text">{{ page.description|nl2br }}</p>{% endset %}
    {{ flaeche.flaeche(iw.description_label, inhalt, 2, 'katalog-abschnitt') }}
    {% endif %}
    {% if page.bosses or page.enemy_groups or page.map %}
    <div class="entity-detail-grid llb-raster{% if page.map and (page.bosses or page.enemy_groups) %} entity-detail-split{% endif %}">
        {% if page.bosses or page.enemy_groups %}<div class="entity-detail-reading">
            {% if page.bosses %}
            {% set inhalt %}<details data-nosnippet><summary>{{ iw.bosses }} · {{ page.bosses|length }}</summary>
                <ul class="instanz-bosse">{% for boss in page.bosses %}<li>{{ boss }}</li>{% endfor %}</ul>
            </details>{% endset %}
            {{ flaeche.flaeche('', inhalt, 2, 'katalog-abschnitt', 'bosse') }}
            {% endif %}
            {% if page.enemy_groups %}
            {% set inhalt %}<details data-nosnippet><summary>{{ iw.enemies }} · {{ iw.enemies_count|format(page.enemy_count) }} · {{ iw.species_count|format(page.species_count) }}</summary>
                <div class="instanz-gegner-gruppen">{% for group in page.enemy_groups %}
                    <div class="instanz-gattung">{% if group.gattung %}<h3>{{ group.gattung }}</h3>{% endif %}
                        {% for art in group.arten %}<p class="instanz-art">{% if art.art %}<span class="instanz-art-name">{{ art.art }}</span>{% endif %}<span class="instanz-art-namen">{{ art.namen|join(', ') }}</span></p>{% endfor %}
                    </div>
                {% endfor %}</div>
            </details>{% endset %}
            {{ flaeche.flaeche('', inhalt, 2, 'katalog-abschnitt', 'gegner') }}
            {% endif %}
        </div>{% endif %}
        {% if page.map %}<div class="entity-detail-place">
            {% set inhalt %}{{ karte.karte(lang, page.map, alt=iw.map, form='bild', breite=page.map_size[0]|default(null), hoehe=page.map_size[1]|default(null)) }}{% endset %}
            {{ flaeche.flaeche(iw.map, inhalt, 2, 'katalog-abschnitt') }}
        </div>{% endif %}
    </div>
    {% endif %}
    {% set sections = {
        aufgaben: {tab: iw.task_tab, heading: iw.tasks, rows: task_fallback, zahl: page.tasks|length},
        aufgabenbelohnungen: {tab: iw.reward_tab, heading: iw.quest_rewards, rows: page.quest_rewards, zahl: page.quest_rewards|length},
        truhenbeute: {tab: iw.loot_tab, heading: iw.loot, rows: page.chest_loot, zahl: page.chest_loot|length}
    }|filter(section => section.rows) %}
    {% if sections %}
    <div class="instanz-reiter" data-instance-lists>
        {% if sections|length > 1 %}
        {% set eintraege = [
            {key: 'aufgaben', label: iw.task_tab, panel: 'aufgaben', zahl: sections.aufgaben.zahl|default(0)},
            {key: 'aufgabenbelohnungen', label: iw.reward_tab, panel: 'aufgabenbelohnungen', zahl: sections.aufgabenbelohnungen.zahl|default(0)},
            {key: 'truhenbeute', label: iw.loot_tab, panel: 'truhenbeute', zahl: sections.truhenbeute.zahl|default(0)}
        ] %}
        {{ reiter.reiter('instanz', iw.tabs, eintraege, (eintraege|first).key, true) }}
        {% endif %}
        {% for key, section in sections %}
        <section id="{{ key }}" class="instanz-listenflaeche"{% if sections|length > 1 %} role="tabpanel" aria-labelledby="instanz-{{ key }}" tabindex="0"{% endif %} data-instance-panel>
            <h2>{{ section.heading }}</h2>
            <div data-instance-list>
                <div data-filter-results>
                    <ul class="mql-row-list">
                        {% if key == 'aufgaben' %}
                            {{ result.heading(lang) }}
                            {% for row in section.rows %}{{ result.row(lang, row.url, row.text, '', symbol('aufgabe')) }}{% endfor %}
                        {% elseif key == 'aufgabenbelohnungen' %}
                            {{ result.heading(lang, iw.reward_quest) }}
                            {% for row in section.rows %}
                            {{ result.row(lang, row.url, row.name, row.meta, symbol(row.icon), row.image, iw.reward_quest, row.quest, '', '', '', row.quest_url, row.eignung|default({})) }}
                            {% endfor %}
                        {% else %}
                            {{ result.heading(lang, iw.loot_chance) }}
                            {% for row in section.rows %}
                            {{ result.row(lang, row.url, row.name, '', symbol('gegenstand'), row.image, iw.loot_chance, row.chance, '', '', '', '', row.eignung|default({})) }}
                            {% endfor %}
                        {% endif %}
                    </ul>
                </div>
            </div>
        </section>
        {% endfor %}
    </div>
    {% endif %}
    <p class="llb-aktionen"><a href="{{ instance_list_url }}">‹ {{ iw.title }}</a></p>
</article>
{% endblock %}

{% block page_scripts %}
    <script type="application/json" id="instance-list-data">{{ instance_list_data|raw }}</script>
    <script src="/instanz-detail.js?v={{ asset_stand }}" defer></script>
{% endblock %}
