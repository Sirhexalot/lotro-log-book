{% extends 'layout.twig' %}
{% import 'components/karte.twig' as karte %}
{% import 'components/reiter.twig' as reiter %}
{% import 'components/ort.twig' as ort %}
{% block inhalt %}
<article class="giver-detail vendor-detail entity-detail-layout">
{% import 'entity/_header.twig' as heading %}
{{ heading.detail(kind, lang, w, vendor.name, icon, '', '', entity_filter_url|default(''), entity_filter_label|default('')) }}
{% if vendor.title %}<p class="giver-art">{{ vendor.title }}</p>{% endif %}
<p class="giver-art">{{ vendor.type_label }}</p>
{% set hat_wo = vendor.places|length > 0 %}
{% set hat_was = vendor.item_total > 0 or vendor.offer_total > 0 %}
{% set beide = hat_wo and hat_was %}
{% if beide %}{{ reiter.reiter('haendler', gw.tab_label, [
    {key:'wo', label: gw.tab_where, panel:'haendler-tab-wo', zahl: vendor.places|length},
    {key:'was', label: gw.tab_goods, panel:'haendler-tab-was', zahl: vendor.item_total + vendor.offer_total}
], 'was') }}{% endif %}

{% if hat_wo %}<section id="haendler-tab-wo" class="katalog-abschnitt vendor-places{% if not beide %} llb-flaeche{% endif %}"{% if beide %} role="tabpanel" aria-labelledby="haendler-wo" tabindex="0" hidden{% endif %}>
<h2>{{ gw.places }}</h2>
{% if vendor.places|length == 1 %}{{ ort.block(lang, vendor.places|first, gw) }}
{% else %}{{ ort.wahl(lang, vendor.places, gw) }}{% endif %}
</section>{% endif %}

{% if hat_was %}<section id="haendler-tab-was" class="katalog-abschnitt vendor-goods{% if not beide %} llb-flaeche{% endif %}"{% if beide %} role="tabpanel" aria-labelledby="haendler-was" tabindex="0"{% endif %}>
{% if vendor.item_total %}<h2>{{ vendor.items_label }}</h2>
{% if vendor.item_total > 5 %}<div class="vendor-items" data-item-filter-root data-item-ids="{{ vendor.item_ids }}" data-filter-area="haendler">
<div class="gs-ergebnis" data-filter-results><ul class="gs-ergebnis">{% for item in vendor.items %}<li><a class="gs-zeile" href="{{ item.url }}"><span class="gs-name">{{ item.name }}</span>{% if item.level %}<span class="gs-meta">{{ gw.level }} {{ item.level }}</span>{% endif %}</a></li>{% endfor %}</ul></div>
</div>
{% else %}<ul class="gs-ergebnis">{% for item in vendor.items %}<li><a class="gs-zeile" href="{{ item.url }}"><span class="gs-name">{{ item.name }}</span>{% if item.level %}<span class="gs-meta">{{ gw.level }} {{ item.level }}</span>{% endif %}</a></li>{% endfor %}</ul>
{% endif %}{% endif %}
{% if vendor.offer_total %}<h2>{{ gw.barter_offers }}</h2>
<div class="vendor-barter" data-tausch-root data-filter-area="haendler-tausch">
<div class="gs-ergebnis" data-filter-results><ul class="gs-ergebnis">
{% for group in vendor.offers %}{% for offer in group.rows %}<li><a class="gs-zeile" href="{{ offer.receive[0].url }}"><span class="gs-name">{{ offer.receive[0].name }}</span><span class="gs-meta">{% for part in offer.give %}{% if not loop.first %} + {% endif %}{{ part.qty }} {{ part.text }}{% endfor %}</span></a></li>{% endfor %}{% endfor %}
</ul></div>
<noscript><p class="llb-hinweis">{{ gw.barter_noscript }}</p></noscript>
<script type="application/json" id="tausch-daten">{{ vendor.tausch|json_encode|raw }}</script>
</div>{% endif %}
</section>{% endif %}

<script src="/texte.js?v={{ asset_stand }}" defer></script>
<script src="/texte-spielstand.js?v={{ asset_stand }}" defer></script>
<script src="/texte-logbuch.js?v={{ asset_stand }}" defer></script>
<script src="/texte-site.js?v={{ asset_stand }}" defer></script>
<script src="/sprache.js?v={{ asset_stand }}" defer></script>
<script src="/gegenstaende-{{ lang }}.js?v={{ asset_stand }}" defer></script>
<script src="/haendler-detail.js?v={{ asset_stand }}" defer></script>
<p><a href="{{ list_url }}">‹ {{ gw.back }}</a></p>
</article>
{% endblock %}
