{# Shared page shell for every catalogue page.
   The markup mirrors what the static generator wrote, so the switch from
   files to PHP does not change a single visible detail. #}
{# Die Marke steht einmal im Titel, auch wenn ein Text sie schon enthält;
   leere Titel fallen auf den Seitennamen zurück. #}
{%- set seo_title = page_seo.title|default('') %}{% if seo_title is empty %}{% set seo_title = 'LOTRO Log Book' %}{% elseif 'LOTRO Log Book' not in seo_title %}{% set seo_title = seo_title ~ ' – LOTRO Log Book' %}{% endif -%}
<!doctype html>
<html lang="{{ lang }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ seo_title }}</title><meta name="description" content="{{ page_seo.description }}">
{% if noindex|default(false) %}<meta name="robots" content="noindex,follow">{% endif %}
<link rel="canonical" href="{{ base }}{{ canonical_url }}">
<script>(function(){var t='dark';try{var s=localStorage.getItem('mql.theme');if(s==='light'||s==='dark')t=s;}catch(e){}document.documentElement.setAttribute('data-theme',t);document.documentElement.style.colorScheme=t;})();</script>
{% if entity_id|default('') %}<link rel="stylesheet" href="/feedback.css?v={{ asset_stand }}">{% endif %}
{% for alt in alternates %}<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ base }}{{ alt.url }}">
{% endfor %}<meta property="og:type" content="website">
<meta property="og:site_name" content="LOTRO Log Book">
<meta property="og:title" content="{{ seo_title }}">
<meta property="og:description" content="{{ page_seo.description }}">
<meta property="og:url" content="{{ base }}{{ canonical_url }}">
<meta property="og:locale" content="{{ og_locale }}">
<meta property="og:image" content="{{ base }}/bild/vorschau-{{ lang }}.jpg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ og_image_alt }}">
<meta name="twitter:card" content="summary_large_image">
{{ tracking|raw }}
{{ styles|raw }}<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{% if related_lists|default([]) %}<link rel="stylesheet" href="/handwerk.css?v={{ asset_stand }}"><link rel="stylesheet" href="/gegenstaende.css?v={{ asset_stand }}"><link rel="stylesheet" href="/entitaeten-listen.css?v={{ asset_stand }}">{% endif %}
{% if index_filter|default(false) %}<link rel="stylesheet" href="/gegenstaende.css?v={{ asset_stand }}"><link rel="stylesheet" href="/filter-ui.css?v={{ asset_stand }}"><link rel="stylesheet" href="/entitaeten-listen.css?v={{ asset_stand }}">{% endif %}
<noscript><style>.kopf .menue,.kopf .charakter{display:flex}.menue-knopf{display:none}</style></noscript>
</head><body class="seite-text katalog-seite" data-art="{{ kind }}" data-entity-id="{{ entity_id|default('') }}" data-katalog-texte="{{ katalog_texte }}">
<header class="kopf"><div class="kopf-innen">
<a class="katalog-marke" href="{{ start_page }}"><svg class="marken-zeichen" viewBox="0 0 100 100" aria-hidden="true" focusable="false"><use href="/lotro-log-book-mark.svg#marke"></use></svg><span class="marken-text">LOTRO Log Book</span></a>
<form class="kopf-suche" action="{{ suche_pfad }}" method="get" role="search"><input type="search" name="q" placeholder="{{ w.search }}" aria-label="{{ w.search }}" autocomplete="off"></form>
<button class="menue-knopf" type="button" aria-label="{{ w.menu }}" aria-controls="menue" aria-expanded="false">☰</button>
<nav class="menue" id="menue">{{ menu|raw }}</nav>

 <div class="charakter"><label class="charakterwahl" hidden><select id="katalog-charakter" aria-label="{{ w.none }}"></select></label><a href="{{ spielstand_pfad }}" class="importieren">{{ w.import_ }}</a></div>
</div></header>
<main class="katalog-inhalt" data-related-filter-limit="{{ related_direct_list_max|default(5) }}">
<div class="katalog-orientierung">
	<nav aria-label="Breadcrumb" class="katalog-pfad">{{ crumbs|raw }}</nav>
	{% if entity_id|default('') %}<a class="entity-feedback-link" href="/{{ lang }}/{{ lang == 'fr' ? 'retour' : 'feedback' }}/" data-feedback-link>{{ {de: 'Feedback zu dieser Seite', en: 'Feedback on this page', fr: 'Donner votre avis sur cette page'}[lang] }} →</a>{% endif %}
</div>
{% block inhalt %}{% endblock %}
</main>
<footer class="seitenfuss"><div class="seitenfuss-innen"><div class="footer-links-links"><p class="footer-statistik"><span data-statistik-aktiv hidden><a class="unterwegs-symbol" href="https://icons8.com/icon/TZNgFj31O74L/gandalf" target="_blank" rel="noopener" aria-label="Gandalf icon by Icons8"><img src="/bild/gandalf.png" alt=""></a><span data-statistik-aktiv-text></span></span></p></div><nav aria-label="Languages" class="sprachen">{{ languages|raw }}</nav><p class="footer-rechts">{% include '_feedback_footer.twig' %} · <a href="/{{ lang }}/plugin/">Plugin</a> · {{ legal|raw }} · {{ privacy|raw }}</p></div></footer>
<script src="/statistik.js?v={{ asset_stand }}" defer></script>
<script src="/status.js?v={{ asset_stand }}" defer></script>
{{ scripts|raw }}
{% if related_lists|default([]) %}
<script type="application/json" id="related-lists">{{ related_json|raw }}</script>
<script type="application/json" id="related-list-symbols">{{ related_icons_json|raw }}</script>
{% for asset in ['texte.js','texte-spielstand.js','texte-logbuch.js','texte-site.js','listen-sprache.js','referenz.js','symbole.js','treffer-zeile.js','handwerk-filter.js','rezepte.js','gegenstaende-filter.js','aufgaben-filter.js','entitaeten-listen.js'] %}<script src="/{{ asset }}?v={{ asset_stand }}" defer></script>{% endfor %}
{% endif %}
{% if index_filter|default(false) %}
{% for asset in ['texte.js','texte-spielstand.js','texte-logbuch.js','texte-site.js','filterzustand.js','filteradapter.js','filter-ui.js','symbole.js','treffer-zeile.js','aufgaben-filter.js','taten-index.js'] %}<script src="/{{ asset }}?v={{ asset_stand }}" defer></script>{% endfor %}
<script src="/taten-index-{{ lang }}.js?v={{ asset_stand }}" defer></script>
<script src="/taten-index.js?v={{ asset_stand }}" defer></script>
{% endif %}
</body></html>
