{# Trage-Voraussetzungen als Datenattribute. eignung.js rechnet daraus die
   Farbe für den importierten Charakter; ohne Charakter bleibt alles neutral. #}
{% macro attribute(eignung) %}{% if eignung|default({})|length %} data-eignung-min="{{ eignung.min|default(0) }}" data-eignung-klasse="{{ eignung.klasse|default('') }}" data-eignung-volk="{{ eignung.volk|default('') }}" data-eignung-armour="{{ eignung.armour|default('') }}" data-eignung-waffe="{{ eignung.waffe|default('') }}" data-eignung-extra="{{ eignung.extra|default(0) }}" data-eignung-scalable="{{ eignung.scalable|default(0) }}"{% endif %}{% endmacro %}
