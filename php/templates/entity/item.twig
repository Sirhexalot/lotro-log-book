{% extends 'layout.twig' %}

{# Item page: eyebrow, symbol, values, resources, sources, crafting, variants,
   set, and a way into the item browser with the same slot. #}
{% block inhalt %}
<article><div class="katalog-kopf">{% if page.eyebrow %}<p class="katalog-augenbraue">{{ page.eyebrow }}</p>{% endif %}<h1{% if page.head_class %} class="{{ page.head_class }}"{% endif %}>{{ symbol_gross|raw }}{{ page.name }}</h1></div>
{% if page.chips %}<p class="katalog-chips">{% for chip in page.chips %}<span class="katalog-chip{{ chip.cls ? ' ' ~ chip.cls : '' }}">{{ chip.text }}</span>{% endfor %}</p>{% endif %}
{% if page.description %}<section><h2>{{ w.description }}</h2><p class="katalog-text">{{ page.description }}</p></section>{% endif %}
{% if page.has_values %}<section><h2>{{ w.values }}</h2>{% if page.armour %}<p class="katalog-grundwert"><span>{{ w.armour }}</span><b>{{ page.armour }}</b></p>{% endif %}{% if page.values %}<dl class="katalog-fakten katalog-werte">{% for row in page.values %}<dt>{{ row.label }}</dt><dd>{{ row.value }}</dd>{% endfor %}</dl>{% endif %}{% if page.bonuses %}<ul class="katalog-boni">{% for row in page.bonuses %}<li><b>{{ row.display }}</b><span>{{ row.label }}</span></li>{% endfor %}</ul>{% endif %}{% if page.scale %}<p class="katalog-hinweis">{{ w.scalable }} {{ page.scale }}</p>{% endif %}</section>{% endif %}
{% if page.resources %}<section><h2>{{ w.occurrences_item }}</h2><ul>{% for resource in page.resources %}<li><strong>{{ resource.name }}</strong>{% if resource.meta %} <span class="katalog-gabe-art">{{ resource.meta }}</span>{% endif %}<br><span class="schwach">{% if resource.places %}{% for place in resource.places %}{% if not loop.first %}, {% endif %}<a href="{{ place.url }}">{{ place.name }}</a> ({{ place.count }}){% endfor %}{% else %}{{ w.no_spots }}{% endif %}</span></li>{% endfor %}</ul></section>{% endif %}
{% if page.sources or page.crafted_by or page.vendor %}<section><h2>{{ w.where_from }}</h2>{% if page.sources %}<ul>{% for source in page.sources %}<li>{% if source.url %}<a href="{{ source.url }}">{{ source.text }}</a>{% else %}{{ source.text }}{% endif %}{% if source.extra %} · {{ source.extra }}{% endif %}</li>{% endfor %}</ul>{% endif %}{% if page.crafted_by %}<h3>{{ w.crafted_by }}</h3><ul>{% for entry in page.crafted_by %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>{% endif %}{% if page.vendor %}<p class="katalog-hinweis">{{ w.vendor }}</p>{% endif %}</section>{% endif %}
{% if page.used_in %}<section><h2>{{ w.used_in }}</h2><p>{{ w.used_count|replace({'%s': page.used_in|length}) }}</p><ul>{% for entry in page.used_in[:50] %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>{% if page.used_in|length > 50 %}<p class="katalog-hinweis">{{ w.more_in_list|replace({'%s': page.used_in|length - 50}) }}</p>{% endif %}</section>{% endif %}

{% if page.set or page.required_class %}<section><h2>{{ w.context }}</h2>{% if page.set %}<h3>{{ w.set_members }}</h3><p>{{ page.set.head }}</p>{% if page.set.members %}<ul>{% for member in page.set.members %}<li>{% if member.url %}<a href="{{ member.url }}">{{ member.text }}</a>{% else %}{{ member.text }}{% endif %}</li>{% endfor %}</ul>{% endif %}{% if page.set.bonuses %}<h3>{{ w.set_bonus }}</h3><ul>{% for bonus in page.set.bonuses %}<li>{{ bonus.amount }} {{ w.set_members }}: {{ bonus.text }}</li>{% endfor %}</ul>{% endif %}{% endif %}{% if page.required_class %}<p>{{ w.required_class }}: {{ page.required_class }}</p>{% endif %}</section>{% endif %}
{% if page.browse %}<section><h2>{{ w.browse }}</h2><p>{{ page.browse.note }}</p><p><a href="{{ page.browse.url }}" class="katalog-knopf">{{ page.browse.text }}</a></p></section>{% endif %}
</article>
{% endblock %}
