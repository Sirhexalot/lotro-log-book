{% extends 'layout.twig' %}

{# Overview page: intro, optional search hint, entries, pagination.
   Craft and catalogue hubs carry sections or plain links instead. #}
{% block inhalt %}
<article><div class="katalog-kopf"><h1>{{ icon|raw }}{{ page.title }}</h1></div>{% if page.search_hint %}<p class="katalog-hinweis"><a href="{{ page.search_hint.url }}">{{ page.search_hint.text }}</a></p>{% endif %}
{% if page.intro %}<p class="katalog-hinweis">{{ page.intro }}</p>{% endif %}
{% if page.entries %}<ul class="katalog-liste">{% for entry in page.entries %}<li>{% if entry.icon %}<img class="symbol" src="/bild/items/{{ entry.icon }}.webp" alt="" width="22" height="22" decoding="async">{% endif %}<a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>{% endif %}
{% for section in page.sections %}<section><h2>{{ section.title }}</h2><ul class="katalog-liste">{% for entry in section.entries %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul></section>{% endfor %}
{% if page.links %}<ul>{% for entry in page.links %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>{% endif %}
{% if page.foot_link %}<p><a href="{{ page.foot_link.url }}">{{ page.foot_link.text }}</a></p>{% endif %}
{% if page.nav %}<nav class="katalog-seiten">{% if page.nav.prev %}<a href="{{ page.nav.prev }}">{{ w.prevpage }}</a> · {% endif %}{{ page.nav.label }}{% if page.nav.next %} · <a href="{{ page.nav.next }}">{{ w.nextpage }}</a>{% endif %}</nav>{% endif %}
</article>
{% endblock %}
