{% extends 'layout.twig' %}
{% import 'components/ort.twig' as ort %}
{% import 'components/belohnungen.twig' as gaben %}
{% import 'components/ziele.twig' as ziele %}
{% import 'components/fakten.twig' as fakten %}
{% import 'components/reiter.twig' as reiter %}

{# Quest page: title, compact facts, then description · where from · rewards ·
   objectives in the reading column and the place beside it. The relations are
   tabs: what requires this quest, and the other quest connections. #}
{% block inhalt %}
<article class="katalog-detailraster entity-detail-layout quest-detail">
{{ include('entity/_heading.twig') }}
{% set area_name = page.area_trail|default([])|map(part => part.text)|join(' › ') %}
{% set progress_chips = page.chips|default([])|filter(chip => chip != page.giver.text|default('') and chip != area_name and not (chip ends with (' ' ~ w.steps_label) or chip ends with (' ' ~ w.rewards))) %}
{{ include('entity/_progress.twig') }}
{% set giver_list = page.givers|default([]) %}
{% if not giver_list and page.giver %}{% set giver_list = [page.giver] %}{% endif %}
{% set herkunft_rows = [] %}
{% if giver_list %}
{% set giver_items = [] %}
{% for eintrag in giver_list %}{% set giver_items = giver_items|merge([{'text': eintrag.text, 'url': eintrag.url}]) %}{% endfor %}
{% set herkunft_rows = herkunft_rows|merge([{'label': w.giver, 'items': giver_items}]) %}
{% endif %}
{% if page.area_trail and not page.place.map_name|default('') %}
{% set herkunft_rows = herkunft_rows|merge([{'label': w.area_label, 'items': page.area_trail}]) %}
{% endif %}
{% set has_requirements = page.requirements.level or page.requirements.all or page.requirements.one or page.requirements.extra %}
{% set introductory_sections %}
{% if page.description %}<section class="katalog-abschnitt llb-flaeche"><h2>{{ w.description }}</h2><p class="katalog-text">{{ page.description }}</p></section>{% endif %}
{% if herkunft_rows or has_requirements %}
<section class="quest-herkunft llb-flaeche" aria-labelledby="quest-herkunft">
<h2 id="quest-herkunft">{{ w.where_from }}</h2>
{% if herkunft_rows %}{{ fakten.liste(herkunft_rows) }}{% endif %}
{% if has_requirements %}<h3>{{ w.requirements }}</h3><ul>
{% if page.requirements.level %}<li>{{ w.level }} {{ page.requirements.level }}</li>{% endif %}
{% if page.requirements.all %}<li>{% for entry in page.requirements.all %}{% if not loop.first %} · {% endif %}<a href="{{ entry.url }}">{{ entry.text }}</a>{% endfor %}</li>{% endif %}
{% if page.requirements.one %}<li>{{ w.one }}: {% for entry in page.requirements.one %}{% if not loop.first %} · {% endif %}<a href="{{ entry.url }}">{{ entry.text }}</a>{% endfor %}</li>{% endif %}
{% if page.requirements.extra %}<li>{{ w.extra }}</li>{% endif %}
</ul>{% endif %}
</section>{% endif %}
{% endset %}
{% set place_panel %}
{% if page.place %}{{ ort.block(lang, page.place, {'map': w.map, 'route': w.route, 'occurrences': w.occurrences, 'points_count': w.points_count}, w.place) }}{% endif %}
{% endset %}
{% set reading_panel %}
{{ introductory_sections }}
{% if page.reward_groups %}<section class="katalog-abschnitt llb-flaeche" data-ton="hell"><h2>{{ w.rewards }}</h2>{{ gaben.gruppen(page.reward_groups, w.sure) }}</section>{% endif %}
{{ ziele.ziele(w.objectives, page.steps) }}
{% endset %}
{{ include('entity/_detail_grid.twig') }}

{% set weitere_label = {de: 'Weitere Aufgabenbezüge', en: 'Other quest connections', fr: 'Autres liens entre quêtes'}[lang] %}
{% set bezug_tabs = [] %}
{% if page.related_quests|default([]) %}{% set bezug_tabs = bezug_tabs|merge([{'key': 'voraus', 'label': w.required_by, 'panel': 'bezug-panel-voraus', 'zahl': page.related_quests|length}]) %}{% endif %}
{% if page.context_columns|default([]) %}{% set bezug_tabs = bezug_tabs|merge([{'key': 'weitere', 'label': weitere_label, 'panel': 'bezug-panel-weitere', 'zahl': page.context_columns|length}]) %}{% endif %}
{% set hat_reiter = bezug_tabs|length > 1 %}
{% if bezug_tabs %}{% if hat_reiter %}{# The bar ships hidden: without JavaScript every area stays readable. #}
{{ reiter.reiter('bezug', w.qlabel, bezug_tabs, 'voraus', true) }}{% endif %}
{% if page.related_quests|default([]) %}
<section id="bezug-panel-voraus"{% if hat_reiter %} role="tabpanel" aria-labelledby="bezug-voraus" tabindex="0"{% else %} class="katalog-abschnitt llb-flaeche"{% endif %}>
{% if not hat_reiter %}<h2>{{ w.required_by }}</h2>{% endif %}
{% for group in related_lists|default([]) %}{% if group.fallback is defined %}
<h3>{{ group.label|default(w.required_by) }}</h3>
<ul data-quellen-liste>{% for entry in group.fallback %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>
<ul class="related-results" data-filter-results hidden></ul>
{% endif %}{% endfor %}
</section>
{% endif %}
{% if page.context_columns|default([]) %}
<section id="bezug-panel-weitere"{% if hat_reiter %} role="tabpanel" aria-labelledby="bezug-weitere" tabindex="0"{% else %} class="katalog-abschnitt llb-flaeche"{% endif %}>
{% if not hat_reiter %}<h2>{{ weitere_label }}</h2>{% endif %}
<div class="katalog-zwei">{% for column in page.context_columns %}{{ fakten.liste(column) }}{% endfor %}</div>
</section>
{% endif %}
{% endif %}
</article>
{% endblock %}
