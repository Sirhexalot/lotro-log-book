{% extends 'layout.twig' %}

{# Quest page: title with icon, chips, then description · place · where from ·
   rewards · context. Objectives stay behind a closed <details>. #}
{% block inhalt %}
<article><div class="katalog-kopf"><h1>{{ icon|raw }}{{ symbol_gross|raw }}{{ page.name }}</h1></div><p id="katalog-status" hidden data-id="{{ page.id }}" data-kind="{{ kind }}" data-profession=""></p>
{% if page.chips %}<p class="katalog-chips">{% for chip in page.chips %}<span class="katalog-chip">{{ chip }}</span>{% endfor %}</p>{% endif %}
{% if page.description %}<section class="katalog-abschnitt"><h2>{{ w.description }}</h2><p class="katalog-text">{{ page.description }}</p></section>{% endif %}
{% if page.place %}<section class="katalog-abschnitt"><h2>{{ w.place }}</h2>{% if page.place.coords %}<div class="katalog-ort-flex">{% if page.place.image %}<a class="katalog-ortlink" href="{{ page.place.map_link }}"><figure class="katalog-ort"><img src="/karten/{{ lang }}/{{ page.place.image|replace({'.png': '.webp'}) }}" alt="" width="320" height="240" loading="lazy" decoding="async"><i class="katalog-pin" style="left:{{ page.place.pin_x|pin }}%;top:{{ page.place.pin_y|pin }}%"></i></figure></a>{% endif %}<div><p class="katalog-hinweis">{{ page.place.coords }}{% if page.place.points %} · {{ w.points_count|replace({'%s': page.place.points}) }}{% endif %}{% if page.place.map_name %} · <a href="{{ page.place.map_link }}">{{ page.place.map_name }}</a> · <a href="{{ page.place.occurrences_url }}">{{ w.occurrences }}</a>{% endif %}</p><p class="katalog-aktionen"><a href="{{ page.place.map_link }}" class="katalog-knopf">{{ w.map }}</a>{% if page.place.travel_url %} <a href="{{ page.place.travel_url }}" class="katalog-link">{{ w.route }}</a>{% endif %}</p></div></div>{% else %}<p class="katalog-aktionen"><a href="{{ page.place.map_link }}" class="katalog-knopf">{{ w.map }}</a>{% if page.place.travel_url %} <a href="{{ page.place.travel_url }}" class="katalog-link">{{ w.route }}</a>{% endif %}</p>{% endif %}</section>{% endif %}
{% if page.giver or page.area_trail or page.requirements.level or page.requirements.all or page.requirements.one or page.requirements.extra %}<section class="katalog-abschnitt"><h2>{{ w.where_from }}</h2><dl class="katalog-fakten">{% if page.giver %}<dt>{{ w.giver }}</dt><dd><a href="{{ page.giver.url }}">{{ page.giver.text }}</a></dd>{% endif %}{% if page.area_trail %}<dt>{{ w.area_label }}</dt><dd>{% for part in page.area_trail %}{% if not loop.first %} › {% endif %}{% if part.url %}<a href="{{ part.url }}">{{ part.text }}</a>{% else %}{{ part.text }}{% endif %}{% endfor %}</dd>{% endif %}</dl>{% if page.requirements.level or page.requirements.all or page.requirements.one or page.requirements.extra %}<h3>{{ w.requirements }}</h3><ul>{% if page.requirements.level %}<li>{{ w.level }} {{ page.requirements.level }}</li>{% endif %}{% if page.requirements.all %}<li>{% for entry in page.requirements.all %}{% if not loop.first %} · {% endif %}<a href="{{ entry.url }}">{{ entry.text }}</a>{% endfor %}</li>{% endif %}{% if page.requirements.one %}<li>{{ w.one }}: {% for entry in page.requirements.one %}{% if not loop.first %} · {% endif %}<a href="{{ entry.url }}">{{ entry.text }}</a>{% endfor %}</li>{% endif %}{% if page.requirements.extra %}<li>{{ w.extra }}</li>{% endif %}</ul>{% endif %}</section>{% endif %}
{% if page.reward_groups or page.required_by %}<section class="katalog-abschnitt"><h2>{{ w.rewards }}</h2>{% if page.reward_groups %}<div class="katalog-gaben">{% for group in page.reward_groups %}<div class="katalog-geben"><div class="katalog-geben-art">{{ group.label }}</div>{% for item in group.items %}<div class="katalog-gabe">{% if item.icon %}<img class="symbol" src="/bild/items/{{ item.icon }}.webp" alt="" width="22" height="22" decoding="async">{% elseif item.symbol %}{{ symbol(item.symbol)|raw }}{% endif %}<span>{% if item.qty > 1 %}{{ item.qty }} × {% endif %}{% if item.url %}<a href="{{ item.url }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}</span></div>{% endfor %}</div>{% endfor %}</div>{% endif %}{% if page.required_by %}<h3>{{ w.required_by }}</h3><ul>{% for entry in page.required_by[:12] %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>{% if page.required_by|length > 12 %}<p class="katalog-hinweis">{{ w.more_in_list|replace({'%s': page.required_by|length - 12}) }}</p>{% endif %}{% endif %}</section>{% endif %}
{% if page.context_columns %}<section class="katalog-abschnitt"><h2>{{ w.context }}</h2><div class="katalog-zwei">{% for column in page.context_columns %}<dl class="katalog-fakten">{% for row in column %}<dt>{{ row.label }}</dt><dd>{% for item in row['items'] %}{% if not loop.first %}{{ row.separator }}{% endif %}{% if item.url %}<a href="{{ item.url }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}{% endfor %}</dd>{% endfor %}</dl>{% endfor %}</div></section>{% endif %}
{% if page.steps %}<details class="katalog-ziele" data-nosnippet><summary>{{ w.objectives }}</summary><ol>{% for step in page.steps %}<li>{% for paragraph in step.paragraphs %}<p class="katalog-text">{{ paragraph }}</p>{% endfor %}<ul>{% for goal in step.objectives %}<li>{{ goal }}</li>{% endfor %}</ul></li>{% endfor %}</ol></details>{% endif %}
</article>
{% endblock %}
