{% extends 'layout.twig' %}
{% import 'components/ort.twig' as ort %}
{% import 'entity/_result_row.twig' as result %}

{# Landmark page: the spot on its map and the quests that lead there.
   The place is the shared place component; no category and no description,
   because the client export leaves both empty. #}
{% block inhalt %}
<article class="landmark-detail entity-detail-layout">
{{ include('entity/_heading.twig') }}
{% set orte = page.place|default({}) %}
{% set kette = [] %}
{% for part in page.place_chain|default([]) %}
{% set kette = kette|merge([{'name': part.text, 'url': part.url|default('')}]) %}
{% endfor %}
{% set ort_daten = {
    'image': orte.image|default(''), 'pin_x': orte.pin_x|default(null), 'pin_y': orte.pin_y|default(null),
    'map_name': page.place_name|default(orte.map_name|default('')), 'coords': orte.coords|default(''),
    'map_url': orte.map_url|default(''), 'map_link': page.map_link|default(''),
    'chain': kette
} %}
<ul class="katalog-metazeile katalog-chips">
{% if orte.map_name|default('') %}<li class="katalog-chip">{{ orte.map_name }}</li>{% endif %}
{% if orte.region|default({}) %}<li class="katalog-chip"><a href="{{ orte.region.url }}">{{ orte.region.text }}</a></li>{% endif %}
{% if page.quests %}<li class="katalog-chip">{{ page.quests|length }} {{ w.qlist }}</li>{% endif %}
</ul>

{% if page.place_name or orte.coords or orte.map_name or orte.image %}
{{ ort.block(lang, ort_daten, {'map': w.map, 'route': w.route, 'occurrences': w.occurrences, 'points_count': w.points_count}, w.place, page.map_link|default('')) }}
{% endif %}

{% if page.quests %}
<section class="katalog-abschnitt llb-flaeche"><h2>{{ w.landmark_here }}</h2>
<ul class="mql-row-list" data-quellen-liste>
{{ result.heading(lang, w.level) }}
{% for ziel in page.quests %}
{{ result.row(lang, ziel.url, ziel.text, '', symbol(ziel.art == 'q' ? 'aufgabe' : 'tat'), '', w.level, ziel.level|default('')) }}
{% endfor %}
</ul>
</section>
{% endif %}

{% if entity_filter_url|default('') %}<p class="llb-aktionen"><a href="{{ entity_filter_url }}">‹ {{ w.llist }}</a></p>{% endif %}
</article>
{% endblock %}
