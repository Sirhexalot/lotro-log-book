{% extends 'layout.twig' %}

{# Area or region page: map entry point, parent, sub-areas and what lies here.
   The three content groups are real tabs. The page carries the complete member
   list once; the browser filters it, so a tab never searches only the rendered
   excerpt. Without JavaScript the server-rendered links below stay usable. #}
{% block inhalt %}
<article class="gebiet"><div class="katalog-kopf"><h1>{{ icon|raw }}{{ page.name }}</h1></div>
{% if page.image %}<figure class="katalog-karte-gross"><img src="/karten/{{ lang }}/{{ page.image|replace({'.png': '.webp'}) }}" alt="{{ page.name }}" width="640" height="480" loading="lazy" decoding="async"></figure>{% endif %}
<p class="katalog-aktionen"><a class="katalog-knopf" href="{{ page.map_url }}">{{ w.area_map }}</a></p>
{% if page.parent %}<p><a href="{{ page.parent.url }}">{{ page.parent.text }}</a></p>{% endif %}
{% if page.children %}<section><h2>{{ page.children_title }}</h2><ul class="katalog-liste">{% for child in page.children %}<li><a href="{{ child.url }}">{{ child.text }}</a></li>{% endfor %}</ul></section>{% endif %}

{% if page.sections %}
<div class="gebiet-buehne" id="gebiet-buehne">
	{% for section in page.sections %}
	<section><h2>{{ section.title }} ({{ section.count }})</h2>
		{% set segment = {q: {de: 'aufgabe', en: 'quest', fr: 'quete'}, d: {de: 'tat', en: 'deed', fr: 'prouesse'}, i: {de: 'gegenstand', en: 'item', fr: 'objet'}} %}
		<ul class="katalog-liste">{% for entry in page.members[section.kind] %}<li><a href="/{{ lang }}/{{ segment[section.kind][lang] }}/{{ entry[0] }}/">{{ entry[1] }}</a></li>{% endfor %}</ul>
	</section>
	{% endfor %}
</div>
{% endif %}
</article>
{% endblock %}
