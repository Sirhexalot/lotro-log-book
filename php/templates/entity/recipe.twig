{% extends 'layout.twig' %}

{# Recipe page: profession, tier, ingredients, critical result. #}
{% block inhalt %}
<article><div class="katalog-kopf"><h1>{{ icon|raw }}{{ symbol_gross|raw }}{{ page.name }}</h1></div><p id="katalog-status" hidden data-id="{{ page.id }}" data-kind="{{ kind }}" data-profession="{{ page.profession_key }}"></p>
<dl class="katalog-fakten"><dt>{{ w.plabel }}</dt><dd><a href="{{ page.profession.url }}">{{ page.profession.text }}</a></dd><dt>{{ w.tier }}</dt><dd>{{ page.tier }}</dd><dt>{{ w.category }}</dt><dd>{{ page.category }}</dd></dl>
{% if page.level %}<p>{{ w.level }} {{ page.level }}</p>{% endif %}
<section><h2>{{ w.ingredients }}</h2><ul>{% for item in page.ingredients %}<li>{% if item.icon %}<img class="symbol" src="/bild/items/{{ item.icon }}.webp" alt="" width="22" height="22" decoding="async">{% endif %}{{ item.amount }} × {% if item.url %}<a href="{{ item.url }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}</li>{% endfor %}</ul></section>
{% if page.optional %}<section><h2>{{ w.optional }}</h2><ul>{% for item in page.optional %}<li>{% if item.icon %}<img class="symbol" src="/bild/items/{{ item.icon }}.webp" alt="" width="22" height="22" decoding="async">{% endif %}{{ item.amount }} × {% if item.url %}<a href="{{ item.url }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}{% if item.chance is defined and item.chance %} ({{ w.chance }} {{ item.chance }} %){% endif %}</li>{% endfor %}</ul></section>{% endif %}
{% if page.critical %}<section><h2>{{ w.critical }}</h2><p>{% if page.critical_symbol %}<img class="symbol" src="/bild/items/{{ page.critical_symbol }}.webp" alt="" width="22" height="22" decoding="async">{% endif %}{{ page.critical }}</p></section>{% endif %}
{% if page.chance %}<p>{{ w.chance }}: {{ page.chance }} %</p>{% endif %}
{% if page.time %}<p>{{ w.time }}: {{ page.time }} s</p>{% endif %}
<p><a href="{{ page.craft_url }}">{{ w.craftlist }}</a></p>
</article>
{% endblock %}
