{% extends 'layout.twig' %}
{% import 'components/ort.twig' as ort %}
{% import 'components/belohnungen.twig' as gaben %}
{% import 'components/ziele.twig' as ziele %}
{% import 'components/fakten.twig' as fakten %}

{# Deed page: the same skeleton as a quest. A deed has no giver and no chain;
   "Woher" names the deed type, its category and its area. The relation lists
   (same area, same category) arrive as two lists and become tabs in the
   browser; without JavaScript both stand as complete lists. #}
{% block inhalt %}
<article class="katalog-detailraster entity-detail-layout deed-detail">{{ include('entity/_heading.twig') }}{{ include('entity/_progress.twig') }}
{% set place_panel %}
{% if page.place %}{{ ort.block(lang, page.place, {'map': w.map, 'route': w.route, 'occurrences': w.occurrences, 'points_count': w.points_count}, w.place, page.map_link) }}{% endif %}
{% endset %}
{% set reward_groups = [] %}
{% if page.rewards_fixed %}{% set reward_groups = reward_groups|merge([{'label': w.sure, 'items': page.rewards_fixed}]) %}{% endif %}
{% if page.rewards_choice %}{% set reward_groups = reward_groups|merge([{'label': w.choice, 'items': page.rewards_choice}]) %}{% endif %}
{% set reading_panel %}
{% if page.description %}<section class="katalog-abschnitt llb-flaeche"><h2>{{ w.description }}</h2><p class="katalog-text">{{ page.description }}</p></section>{% endif %}
{% if page.facts %}<section class="katalog-abschnitt llb-flaeche"><h2>{{ w.where_from }}</h2>{{ fakten.liste(page.facts) }}</section>{% endif %}
{% if reward_groups %}<section class="katalog-abschnitt llb-flaeche" data-ton="hell"><h2>{{ w.rewards }}</h2>{{ gaben.gruppen(reward_groups, w.sure) }}</section>{% endif %}
{% if not page.place %}<p class="llb-aktionen"><a href="{{ page.map_link }}" class="llb-knopf">{{ w.map }}</a></p>{% endif %}
{{ ziele.ziele(w.objectives, page.steps) }}
{% endset %}
{{ include('entity/_detail_grid.twig') }}
{% if related_lists|default([]) %}<section class="katalog-abschnitt katalog-beziehungen llb-flaeche">
<h2>{{ {de: 'Verwandte Taten', en: 'Related deeds', fr: 'Prouesses associées'}[lang] }}</h2>
<p class="llb-hinweis" data-related-intro>{{ {de: 'Weitere Taten aus demselben Gebiet oder derselben Kategorie.', en: 'Other deeds in the same area or category.', fr: 'Autres prouesses de la même zone ou de la même catégorie.'}[lang] }}</p>
{% for group in related_lists %}{% if group.fallback is defined %}
<h3>{{ group.label|default({de: 'Verwandte Taten', en: 'Related deeds', fr: 'Prouesses associées'}[lang]) }}</h3>
<ul data-quellen-liste>{% for entry in group.fallback %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul>
{% endif %}{% endfor %}
<ul class="related-results" data-filter-results hidden></ul>
</section>{% endif %}
</article>
{% endblock %}
