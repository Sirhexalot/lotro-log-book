{% extends 'layout.twig' %}

{# Deed page: same order as quests, but deeds have no giver and no chain.
   "Woher" names the deed type and category, "Zusammenhang" links neighbours
   in the same area or of the same kind. #}
{% block inhalt %}
<article class="katalog-detailraster entity-detail-layout">{{ include('entity/_heading.twig') }}{{ include('entity/_progress.twig') }}
{% set place_panel %}
{% if page.place %}<section class="katalog-abschnitt quest-detail-ort"><h2>{{ w.place }}</h2>
{% for map in page.place.images %}<figure class="katalog-ort"><img src="/karten/{{ lang }}/{{ map.map }}.webp" alt="" width="320" height="240" loading="lazy" decoding="async"><i class="katalog-pin" style="left:{{ map.pin_x|pin }}%;top:{{ map.pin_y|pin }}%"></i></figure>{% endfor %}
<p class="katalog-hinweis">{{ page.place.hint }}</p><p class="katalog-aktionen"><a href="{{ page.map_link }}" class="katalog-knopf">{{ w.map }}</a></p>
</section>{% endif %}
{% endset %}
{% set reading_panel %}
{% if page.description %}<section class="katalog-abschnitt llb-flaeche"><h2>{{ w.description }}</h2><p class="katalog-text">{{ page.description }}</p></section>{% endif %}
{% if page.facts %}<section class="katalog-abschnitt"><h2>{{ w.where_from }}</h2><dl class="llb-fakten">{% for fact in page.facts %}<dt>{{ fact.label }}</dt><dd>{{ fact.text }}</dd>{% endfor %}</dl></section>{% endif %}
{% if page.rewards_fixed or page.rewards_choice %}<section class="katalog-abschnitt katalog-flaeche"><h2>{{ w.rewards }}</h2>
{% for item in page.rewards_fixed %}{% include 'entity/reward.twig' with {'item': item} only %}{% endfor %}
{% if page.rewards_choice %}<h3>{{ w.choice }}</h3>{% for item in page.rewards_choice %}{% include 'entity/reward.twig' with {'item': item} only %}{% endfor %}{% endif %}
</section>{% endif %}
{% if not page.place %}<p class="katalog-aktionen"><a href="{{ page.map_link }}" class="katalog-knopf">{{ w.map }}</a></p>{% endif %}
{% if page.steps %}<details class="katalog-ziele" data-nosnippet><summary>{{ w.objectives }}</summary><ol>{% for step in page.steps %}<li>{% for paragraph in step.paragraphs %}<p class="katalog-text">{{ paragraph }}</p>{% endfor %}<ul>{% for goal in step.objectives %}<li>{{ goal }}</li>{% endfor %}</ul></li>{% endfor %}</ol></details>{% endif %}
{% endset %}
{{ include('entity/_detail_grid.twig') }}
{% for group in related_lists|default([]) %}{% if group.fallback is defined %}<section class="katalog-abschnitt katalog-beziehungen">
<h2>{{ {de: 'Verwandte Taten', en: 'Related deeds', fr: 'Prouesses associées'}[lang] }}</h2>
<p class="katalog-hinweis" data-related-intro>{{ {de: 'Weitere Taten aus demselben Gebiet oder derselben Kategorie.', en: 'Other deeds in the same area or category.', fr: 'Autres prouesses de la même zone ou de la même catégorie.'}[lang] }}</p>
<ul data-quellen-liste>{% for entry in group.fallback %}<li><a href="{{ entry.url }}">{{ entry.text }}</a></li>{% endfor %}</ul><ul class="related-results" data-filter-results hidden></ul>
</section>{% endif %}{% endfor %}
</article>
{% endblock %}
