{# One reward line, shared by deeds and other entity pages. #}
<div class="katalog-gabe">
{%- if item.kind == 'item' -%}
{%- if item.icon %}<span class="mql-row-icon mql-row-icon-item" aria-hidden="true"><img src="/bild/items/{{ item.icon }}.webp" alt="" width="48" height="48" loading="lazy" decoding="async"></span>{% endif -%}
<span>{% if item.qty %}{{ item.qty }} × {% endif %}{% if item.url %}<a href="{{ item.url }}">{{ item.text }}</a>{% else %}{{ item.text }}{% endif %}</span>
{%- elseif item.kind == 'title' -%}
<span class="mql-row-icon mql-row-icon-entity" aria-hidden="true">{{ symbol('titel')|raw }}</span><span><span class="katalog-gabe-art">{{ item.label }}</span> {{ item.text }}</span>
{%- elseif item.kind == 'virtue' -%}
<span class="mql-row-icon mql-row-icon-entity" aria-hidden="true">{{ symbol('tugend')|raw }}</span><span><span class="katalog-gabe-art">{{ item.label }}</span> {{ item.text }}</span>
{%- else -%}
<span class="katalog-gabe-art">{{ item.label }}</span> {{ item.text }}
{%- endif -%}
</div>
