{% extends 'layout.twig' %}
{% block inhalt %}
<article class="set-detail">
{% import 'entity/_header.twig' as heading %}
{% import 'components/eignung.twig' as eignung %}
{{ heading.detail(kind, lang, w, set.name, icon, '', '', entity_filter_url|default(''), entity_filter_label|default('')) }}<p class="set-kopf"><span>{{ sw.parts|replace({'%s': set.parts}) }}</span>{% if set.teile|default([]) %}<span class="set-eignung" data-eignung-teile="{{ set.teile|json_encode|e('html_attr') }}"></span>{% endif %}</p>
<p class="llb-aktionen"><a class="llb-knopf" href="#setteile">{{ sw.pieces }}</a> <a class="llb-knopf" href="#setboni">{{ sw.bonuses }}</a></p>
<section id="setteile"><h2>{{ sw.pieces }}</h2>
<div class="set-cards">
{% for member in set.members|filter(member => member.name) %}
<article class="set-card{% if member.missing %} set-card-missing{% endif %}">
    <h3>{% if member.card and member.card.symbol %}<img src="/bild/items/{{ member.card.symbol }}.webp" alt="" width="32" height="32" loading="lazy">{% endif %}{% if member.url %}<a{% if member.card and member.card.head_class %} class="{{ member.card.head_class }}"{% endif %} href="{{ member.url }}">{{ member.name }}</a>{% else %}{{ member.name }}{% endif %}{% if member.count > 1 %} <span class="set-card-count">· {{ member.count }}×</span>{% endif %}</h3>
    {% if member.card %}
        <p class="set-card-meta">{% for chip in member.card.chips %}<span{{ eignung.attribute(chip.eignung|default({})) }}>{{ chip.text }}</span>{% endfor %}</p>
        {% if member.card.required_class %}<p>{{ sw.class }}: {{ member.card.required_class }}</p>{% endif %}
        {% if member.card.armour %}<p>{{ sw.armour }}: {{ member.card.armour }}</p>{% endif %}
        {% if member.card.values %}<dl>{% for row in member.card.values %}<dt>{{ row.label }}</dt><dd>{{ row.value }}</dd>{% endfor %}</dl>{% endif %}
        {% if member.card.bonuses %}<ul class="set-card-stats">{% for row in member.card.bonuses %}<li>{{ row.display }} {{ row.label }}</li>{% endfor %}</ul>{% endif %}
        <a href="{{ member.url }}">{{ sw.item }} →</a>
    {% endif %}
</article>
{% endfor %}
</div></section>
<section class="set-bonuses" id="setboni"><h2>{{ sw.bonuses }}</h2>
{% for bonus in set.bonuses %}
    {% if bonus.valid %}<h3>{{ sw.threshold|replace({'%s': bonus.pieces}) }}</h3>{% endif %}
    <ul>{% for text in bonus.texts %}<li>{{ text }}</li>{% endfor %}
    {% for pending in bonus.pending %}{% if pending.label %}<li>{{ pending.label }}{% if pending.scaling %}: {{ sw.scaling }}{% endif %}</li>{% endif %}{% endfor %}</ul>
{% endfor %}
</section>
<p><a href="{{ list_url }}">‹ {{ sw.back }}</a></p>
</article>
{% endblock %}
