{% extends 'layout.twig' %}
{% import 'entity/_result_row.twig' as result %}
{% import 'components/reiter.twig' as reiter %}

{# Set page: what the set is, its pieces and its bonuses. The pieces read like
   every other list — name, one line of facts, link to the item page. The
   values of a piece belong to the item page, not here. #}
{% block inhalt %}
<article class="set-detail entity-detail-layout">
{% import 'entity/_header.twig' as heading %}
{{ heading.detail(kind, lang, w, set.name, icon, '', '', entity_filter_url|default(''), entity_filter_label|default('')) }}
<ul class="katalog-metazeile katalog-chips">
<li class="katalog-chip">{{ sw.parts|replace({'%s': set.parts}) }}</li>
{% if set.teile|default([]) %}<li class="katalog-chip set-eignung" data-eignung-teile="{{ set.teile|json_encode|e('html_attr') }}"></li>{% endif %}
</ul>

{% set teile = set.members|filter(member => member.name) %}
{% set tabs = [] %}
{% if teile %}{% set tabs = tabs|merge([{'key': 'teile', 'label': sw.pieces, 'panel': 'set-panel-teile', 'zahl': set.parts}]) %}{% endif %}
{% if set.bonuses %}{% set tabs = tabs|merge([{'key': 'boni', 'label': sw.bonuses, 'panel': 'set-panel-boni', 'zahl': set.bonuses|length}]) %}{% endif %}
{% set mit_reitern = tabs|length > 1 %}
{% if mit_reitern %}{{ reiter.reiter('set', set.name, tabs, (tabs|first).key, true) }}{% endif %}

{% if teile %}
<section id="set-panel-teile"{% if mit_reitern %} role="tabpanel" aria-labelledby="set-teile" tabindex="0"{% else %} class="katalog-abschnitt llb-flaeche"{% endif %}>
{% if not mit_reitern %}<h2>{{ sw.pieces }}</h2>{% endif %}
<ul class="mql-row-list">
{% for member in teile %}
{% set karte = member.card|default({}) %}
{% set zeile = [] %}
{# Identity and classification only, like every list row: rarity and the wear
   requirement. Values, binding and slots belong to the piece's item page. #}
{% for chip in karte.chips|default([])|slice(0, 2) %}{% set zeile = zeile|merge([chip.text]) %}{% endfor %}
{% if member.count|default(0) > 1 %}{% set zeile = zeile|merge(['× ' ~ member.count]) %}{% endif %}
{{ result.row(lang, member.url|default(''), member.name, zeile|join(' · '), '', karte.symbol|default(''), '', '', '', '', '', '', {}, '', '') }}
{% endfor %}
</ul>
</section>
{% endif %}

{% if set.bonuses %}
<section id="set-panel-boni"{% if mit_reitern %} role="tabpanel" aria-labelledby="set-boni" tabindex="0"{% else %} class="katalog-abschnitt llb-flaeche"{% endif %}>
{% if not mit_reitern %}<h2>{{ sw.bonuses }}</h2>{% endif %}
{% for bonus in set.bonuses %}
{% if bonus.valid %}<h3>{{ sw.threshold|replace({'%s': bonus.pieces}) }}</h3>{% endif %}
<ul>{% for text in bonus.texts %}<li>{{ text }}</li>{% endfor %}
{% for pending in bonus.pending %}{% if pending.label %}<li>{{ pending.label }}{% if pending.scaling %}: {{ sw.scaling }}{% endif %}</li>{% endif %}{% endfor %}</ul>
{% endfor %}
</section>
{% endif %}

<p class="llb-aktionen"><a href="{{ list_url }}">‹ {{ sw.back }}</a></p>
</article>
{% endblock %}
