{% extends 'layout.twig' %}
{% import 'entity/_result_row.twig' as result %}
{# Die Liste filtert im Browser (`web/sets-filter.js`), weil die Eignung am
   importierten Charakter hängt und der im Browser bleibt. Das GET-Formular
   bleibt die Antwort ohne JavaScript und die Fassung für Suchmaschinen. #}
{% block inhalt %}
<div class="sets-browser" data-set-browser data-filter-area="sets" data-set-texte="{{ sw.klient|json_encode|e('html_attr') }}">
<h1>{{ sw.title }}</h1><p>{{ sw.intro }}</p>
<form method="get" action="{{ list_url }}" class="sets-form" data-filter-fallback>
    <div class="sets-search"><label for="set-query">{{ sw.search }}</label><div><input type="search" id="set-query" name="q" value="{{ filters.q }}"><button type="submit">{{ sw.search }}</button></div></div>
    <div class="sets-grid">
        <details class="sets-filters" open>
            <summary>{{ sw.filter }}</summary>
            {% for key, options in facets %}{% if options %}
            <fieldset><legend>{{ attribute(sw, key) }}</legend>
                {% for option in options %}<label class="sets-option"><input type="checkbox" name="{{ key }}[]" value="{{ option.value }}"{% if option.checked %} checked{% endif %}><span>{{ option.label }}</span><small>{{ option.count }}</small></label>{% endfor %}
            </fieldset>{% endif %}{% endfor %}
            <fieldset><legend>{{ sw.level }}</legend><div class="sets-range"><label>{{ sw.from }}<input type="number" name="from" min="0" max="999" value="{{ filters.from }}"></label><label>{{ sw.to }}<input type="number" name="to" min="0" max="999" value="{{ filters.to }}"></label></div></fieldset>
            <div class="sets-filter-actions"><button type="submit">{{ sw.apply }}</button><a href="{{ list_url }}">{{ sw.reset }}</a></div>
        </details>
        <section class="sets-results" data-filter-results aria-label="{{ sw.title }}">
            <p class="sets-count" role="status">{{ sw.count|replace({'%s': count}) }}</p>
            <ul class="sets-list mql-row-list">{% if sets %}{{ result.heading(lang) }}{% endif %}{% for row in sets %}{{ result.row(lang, row.url, row.name, [sw.parts|replace({'%s': row.parts}), row.meta]|filter(v => v)|join(' · '), entity_symbol, row.icons|default([])|first|default('')) }}{% else %}<li>{{ sw.empty }}</li>{% endfor %}</ul>
            {% if previous_url or next_url %}<nav class="sets-pagination" aria-label="{{ sw.title }}">
                {% if previous_url %}<a href="{{ previous_url }}">‹ {{ sw.previous }}</a>{% endif %}
                <span>{{ page_label }}</span>
                {% if next_url %}<a href="{{ next_url }}">{{ sw.next }} ›</a>{% endif %}
            </nav>{% endif %}
        </section>
    </div>
</form>
</div>
{% endblock %}
{% block page_scripts %}
<script src="/sets-{{ lang }}.js?v={{ asset_stand }}" defer></script>
<script src="/sets-filter.js?v={{ asset_stand }}" defer></script>
{% endblock %}
