# One public address: https://llb.sirhexalot.de. Every other name that reaches
# this folder - sirhexalot.de, www, mm - goes there in one 301, path and query
# kept. Plain http is upgraded by the host's HTTPS redirect before this runs,
# so no %{HTTPS} check here: a TLS-terminating proxy would make it loop.
RewriteEngine On
RewriteCond %{HTTP_HOST} !^llb\.sirhexalot\.de$ [NC]
RewriteRule ^ https://llb.sirhexalot.de%{REQUEST_URI} [R=301,L]

# A local error document preserves HTTP 404 and applies to all subdirectories.
ErrorDocument 404 /404.html

# Stable entity URLs; flat HTML storage avoids one directory per game record.
# Exactly one public form per page, the trailing-slash URL: the flat file and the
# form without the slash are sent there with 301, so search engines never see
# three addresses for the same entity.
# BEGIN LLB PHP URLS
# Catalog, application pages and sitemaps are rendered by PHP. The old static
# files stay on disk as a rollback and are never served again.
# Code, data and cache live in the document root but are not web content.
RewriteRule ^(phpdata|php|vendor|phptmp)(/|$) - [F]
# The root keeps the map application, as before, one redirect further.
RewriteRule ^$ /index.php [END]
RewriteRule ^(start(-(en|fr))?|index|gegenstaende|handwerk|reise|ruf|belohnungen|spielstand|companion|plugin|suche|gegenstand)\.html$ /index.php [END]
RewriteRule ^(de|en|fr)(/|$) /index.php [END]
RewriteRule ^sitemap(-[a-z0-9-]+)?\.xml$ /index.php [END]
# END LLB PHP URLS

# Compress text: the data files shrink from 17 MB to under 4 MB.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json image/svg+xml
</IfModule>

# Static files carry ?v=<hash> from the site build, so the browser may keep them.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
